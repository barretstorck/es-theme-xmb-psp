<?xml version="1.0" encoding="UTF-8"?>
<!--
  es-theme-xmb-psp - "Parallax" wave motion.

  Two-tone contrast scheme:
    Base layer (waveBackground):  full-screen dark ${waveTint}, static,
                                  acts as the canvas.
    Highlight layer (waveBackground2): same wave.png tinted with the
                                  brighter ${accent} color, diagonally
                                  drifting. Creates moving wave
                                  highlights against the dark base.

  Known limitation: both layers are extra="true" elements that scroll
  with the carousel in system view, so motion visually resets on
  system change. ES does not provide a non-extra background slot that
  decouples from the carousel in this build.
-->
<theme>
  <formatVersion>7</formatVersion>
  <view name="system,detailed">

    <!-- Base layer: dark colorset tint, no motion -->
    <image name="waveBackground" extra="true">
      <size>1.10 1.10</size>
      <opacity>1.00</opacity>
    </image>

    <!-- Highlight layer: brighter accent color, diagonal drift -->
    <image name="waveBackground2" extra="true">
      <path>./art/wave/wave.png</path>
      <pos>0.5 0.5</pos>
      <size>1.40 1.40</size>
      <origin>0.5 0.5</origin>
      <color>${accent}</color>
      <opacity>0.60</opacity>
      <zIndex>1</zIndex>
      <storyboard>
        <animation property="x" from="0.40" to="0.60"
                   duration="15000" mode="easeInOut"
                   autoreverse="true" repeat="forever"/>
        <animation property="y" from="0.45" to="0.55"
                   duration="22000" mode="easeInOut"
                   autoreverse="true" repeat="forever"/>
      </storyboard>
    </image>

  </view>
</theme>
