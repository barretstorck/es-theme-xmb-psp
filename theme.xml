<!-- defaultTransition: ES consults this when the global Transition Style
     setting is "auto". Without it, "auto" view transitions fall back to
     "slide"; "instant" is this theme's intended feel. An explicit user
     Transition Style setting still overrides this. -->
<theme defaultTransition="instant">
  <formatVersion>7</formatVersion>

  <!-- ES (formatVersion 7) processes theme.xml children in document order,
       and resolves ${variable} placeholders at element-parse time (not lazily).
       The correct order is:
         1. common.xml  - sets default variable values
         2. colorset    - overrides colorset variables (waveTint, accent, etc.)
         3. mode subsets - iconSize / titleVisibility / videoDelay defaults
         4. aspect-*.xml - per-ratio fit corrections (must beat mode subsets)
         5. view files  - consume the now-resolved variable values
       The colorset subset MUST come after common.xml and before the view
       includes. Gamecount can go anywhere since it only affects element
       visibility, not color variables. -->

  <include>./_inc/common.xml</include>

  <!-- v0.11 redesign: per-system media-fallback. Sets ${mediaFallbackPath}
       so the gamelist itemTemplate's <tplFallbackIcon> image resolves to a
       system-appropriate glyph when {game:thumbnail} is empty. Nested
       variable indirection (${mediaFallback${system.theme}}) was spiked
       and failed on this Knulli ES build, so this list of conditional
       includes is the fallback path. _default loads first so unmapped
       systems still resolve; matching system override wins by being
       later in document order. -->
  <include>./_inc/media-fallback/_default.xml</include>
  <include if="${system.theme} == 'amiga'">./_inc/media-fallback/amiga.xml</include>
  <include if="${system.theme} == 'amiga1200'">./_inc/media-fallback/amiga1200.xml</include>
  <include if="${system.theme} == 'amiga500'">./_inc/media-fallback/amiga500.xml</include>
  <include if="${system.theme} == 'amigacd32'">./_inc/media-fallback/amigacd32.xml</include>
  <include if="${system.theme} == 'amigacdtv'">./_inc/media-fallback/amigacdtv.xml</include>
  <include if="${system.theme} == 'amstradcpc'">./_inc/media-fallback/amstradcpc.xml</include>
  <include if="${system.theme} == 'apple2'">./_inc/media-fallback/apple2.xml</include>
  <include if="${system.theme} == 'apple2gs'">./_inc/media-fallback/apple2gs.xml</include>
  <include if="${system.theme} == 'atari2600'">./_inc/media-fallback/atari2600.xml</include>
  <include if="${system.theme} == 'atari5200'">./_inc/media-fallback/atari5200.xml</include>
  <include if="${system.theme} == 'atari7800'">./_inc/media-fallback/atari7800.xml</include>
  <include if="${system.theme} == 'atarijaguar'">./_inc/media-fallback/atarijaguar.xml</include>
  <include if="${system.theme} == 'atarilynx'">./_inc/media-fallback/atarilynx.xml</include>
  <include if="${system.theme} == 'atarist'">./_inc/media-fallback/atarist.xml</include>
  <include if="${system.theme} == 'atomiswave'">./_inc/media-fallback/atomiswave.xml</include>
  <include if="${system.theme} == 'c128'">./_inc/media-fallback/c128.xml</include>
  <include if="${system.theme} == 'c64'">./_inc/media-fallback/c64.xml</include>
  <include if="${system.theme} == 'colecovision'">./_inc/media-fallback/colecovision.xml</include>
  <include if="${system.theme} == 'dos'">./_inc/media-fallback/dos.xml</include>
  <include if="${system.theme} == 'dreamcast'">./_inc/media-fallback/dreamcast.xml</include>
  <include if="${system.theme} == 'fbneo'">./_inc/media-fallback/fbneo.xml</include>
  <include if="${system.theme} == 'fds'">./_inc/media-fallback/fds.xml</include>
  <include if="${system.theme} == 'gamate'">./_inc/media-fallback/gamate.xml</include>
  <include if="${system.theme} == 'gameandwatch'">./_inc/media-fallback/gameandwatch.xml</include>
