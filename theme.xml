  <include if="${system.theme} == 'pce-cd'">./_inc/media-fallback/pce-cd.xml</include>
  <include if="${system.theme} == 'pcengine'">./_inc/media-fallback/pcengine.xml</include>
  <include if="${system.theme} == 'pokemini'">./_inc/media-fallback/pokemini.xml</include>
  <include if="${system.theme} == 'psp'">./_inc/media-fallback/psp.xml</include>
  <include if="${system.theme} == 'psx'">./_inc/media-fallback/psx.xml</include>
  <include if="${system.theme} == 'satellaview'">./_inc/media-fallback/satellaview.xml</include>
  <include if="${system.theme} == 'saturn'">./_inc/media-fallback/saturn.xml</include>
  <include if="${system.theme} == 'scummvm'">./_inc/media-fallback/scummvm.xml</include>
