  <include if="${system.theme} == 'namco22'">./_inc/media-fallback/namco22.xml</include>
  <include if="${system.theme} == 'naomi'">./_inc/media-fallback/naomi.xml</include>
  <include if="${system.theme} == 'naomi2'">./_inc/media-fallback/naomi2.xml</include>
  <include if="${system.theme} == 'nds'">./_inc/media-fallback/nds.xml</include>
  <include if="${system.theme} == 'neogeo'">./_inc/media-fallback/neogeo.xml</include>
