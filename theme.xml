<?xml version="1.0" encoding="UTF-8"?>
<!--
  es-theme-xmb-psp - PSP XMB theme for batocera-emulationstation
  Derivative of "XMB Menu ES-DE" by Ant (anthonycaccese), itself derived
  from "XMB-Easy-Theme" by InitialDin. CC-BY-NC-SA 2.0.
  Full attribution: see CREDITS.md
-->
<!-- defaultTransition: ES consults this when the global Transition Style
     setting is "auto". Without it, "auto" view transitions fall back to
     "slide"; "instant" is this theme's intended feel. An explicit user
     Transition Style setting still overrides this. -->
<theme defaultTransition="instant">
  <formatVersion>7</formatVersion>

  <!-- ES (formatVersion 7) processes theme.xml children in document order,
       and resolves ${variable} placeholders at element-parse time (not lazily).
       The correct order is:
         1. common.xml   - sets default variable values
         2. colorset     - overrides colorset variables (waveTint, accent, etc.)
         3. variable-only subsets - iconSize / titleVisibility / videoDelay /
            videoAudio defaults
         4. aspect-*.xml - per-ratio fit corrections (must beat the subsets above)
         5. gamelistStyle subset - the view files; consume the now-resolved
            variable values
       The colorset subset MUST come after common.xml and before the view
       includes. videoAudio moved into this group in v0.12 when it was
       folded onto the new media elements (see its subset comment below) -
       before that it targeted the hidden legacy md_video element and its
       position didn't matter. scrollSpeed stays declared near the end of
       this file, and that position is load-bearing: it sets
       autoScrollSpeed on cardDesc / listDesc, so it must be parsed AFTER
       the gamelistStyle subset that defines them. Element properties
       merge last-write-wins at parse time, so a style file that later
       grew its own autoScrollSpeed would silently beat the user's
       choice from anywhere earlier (§7.4 of the style guide).
       Gamecount can go anywhere since it only affects element
       visibility, not color variables. -->

  <!-- v1.0: helpsystem face-button glyph set (audit S4, #8). Declared BEFORE
       common.xml, unlike every other subset in this file, and that position is
       load-bearing: these files set variables (${helpIconA}..${helpIconY}) and
       common.xml's <helpsystem> consumes them, so the subset has to be parsed
       first or the four face slots resolve to unsubstituted literals and ES
       silently falls back to its built-in glyphs. Nothing here reads a value
       common.xml defines, so nothing is lost by going first. Nintendo is the
       default by being the first include - the TrimUI Brick's buttons carry
       that layout.

       Variables rather than <helpsystem> overrides on purpose. Box Art Grid
       declares its own <helpsystem> inside <view name="grid">, and an override
       file naming that view would make hasView("grid") true for everyone,
       handing an unstyled built-in grid to any user who had pinned Gamelist
       View Style = grid (the b5e2063 regression). A <variables> block
       registers no views, and _inc/gamelist-grid.xml reads the same four
       names, so the setting reaches all three gamelist styles. -->
  <!-- The default, as a plain include, BEFORE the subset that can override it.
       This is not belt-and-braces: on the device's ES (Version 39, built
       2026-05-11) a buttonGlyphs value that has never been chosen leaves
       ${helpIconA}..${helpIconY} unresolved rather than falling back to the
       subset's first <include>, the way the pinned harness build does. The
       failure is worse than losing the four face glyphs — an unresolved
       variable in the first icon property drops EVERY icon property on the
       element, including the eight shared ones that are literal paths, so a
       fresh install rendered ES's stock glyphs throughout while keeping the
       theme's helpsystem position, font and colour (those parse earlier).
       Caught on hardware; the harness cannot see it, because there the first
       include does apply.

       Including the Nintendo file directly costs nothing when the subset does
       resolve — same four variables, parsed earlier, overwritten by whichever
       set is selected. It also means the documented default lives in exactly
       one file rather than being implied by include order. -->
  <include>./_inc/buttons-nintendo.xml</include>

  <subset name="buttonGlyphs" displayName="Button Icons">
    <include name="Nintendo">./_inc/buttons-nintendo.xml</include>
    <include name="PSP">./_inc/buttons-psp.xml</include>
    <include name="Xbox">./_inc/buttons-xbox.xml</include>
  </subset>

  <include>./_inc/common.xml</include>

  <!-- Media-fallback. Sets ${mediaFallbackPath} so the gamelist styles'
       fallback image resolves to a system-appropriate glyph when
       {game:thumbnail} is empty. Nested variable indirection
       (${mediaFallback${system.theme}}) was spiked and failed on this Knulli
       ES build, so conditional includes are the fallback path. _default
       loads first so unmapped systems still resolve; a matching override
       wins by being later in document order.

       ONE INCLUDE PER GLYPH. This was 75 include lines pointing at 75
       near-identical files, which between them held only SEVEN distinct
       paths. It is now six lines and six files, each naming the systems
       that share one glyph — see the header of each file for the list.

       The `||` is real: <include if> is evaluated by MathExpr
       (ThemeData.cpp:1178), whose operator table carries "||" at precedence
       -3, below "==" at -1, so each comparison binds first
       (MathExpr.cpp:94,820). Verified on pixels, not just on the source —
       an unscraped PSX game still resolves to the disc glyph and an
       unscraped NES game to the cartridge, with the card media slot
       byte-identical to the per-system arrangement.

       Attribute values are wrapped across lines on purpose: XML normalises a
       newline inside an attribute to a space before MathExpr ever sees it,
       and a thousand-character line is unreviewable in a diff. -->
  <include>./_inc/media-fallback/_default.xml</include>
  <include if="${system.theme} == 'amiga' || ${system.theme} == 'amiga1200' ||
       ${system.theme} == 'amiga500' || ${system.theme} == 'amigacdtv' ||
       ${system.theme} == 'amstradcpc' || ${system.theme} == 'atarist' ||
       ${system.theme} == 'c128' || ${system.theme} == 'c64' ||
       ${system.theme} == 'msx' || ${system.theme} == 'msx1' ||
       ${system.theme} == 'msx2' || ${system.theme} == 'pc88' ||
       ${system.theme} == 'pc98' || ${system.theme} == 'x68000' ||
       ${system.theme} == 'zxspectrum'">./_inc/media-fallback/floppy.xml</include>
  <include if="${system.theme} == 'amigacd32' || ${system.theme} == 'dreamcast' ||
       ${system.theme} == 'naomi' || ${system.theme} == 'neogeocd' ||
       ${system.theme} == 'pce-cd' || ${system.theme} == 'psx' ||
       ${system.theme} == 'saturn' || ${system.theme} == 'segacd'">./_inc/media-fallback/cd.xml</include>
  <include if="${system.theme} == 'apple2' || ${system.theme} == 'apple2gs' ||
       ${system.theme} == 'dos' || ${system.theme} == 'macintosh' ||
       ${system.theme} == 'pc' || ${system.theme} == 'scummvm'">./_inc/media-fallback/computer.xml</include>
  <include if="${system.theme} == 'atari2600' || ${system.theme} == 'atari5200' ||
       ${system.theme} == 'atari7800' ||
       ${system.theme} == 'atarijaguar' ||
       ${system.theme} == 'colecovision' || ${system.theme} == 'fds' ||
       ${system.theme} == 'intellivision' ||
       ${system.theme} == 'mastersystem' ||
       ${system.theme} == 'megadrive' || ${system.theme} == 'n64' ||
       ${system.theme} == 'n64dd' || ${system.theme} == 'nes' ||
       ${system.theme} == 'pcengine' || ${system.theme} == 'satellaview' ||
       ${system.theme} == 'sega32x' || ${system.theme} == 'sg-1000' ||
       ${system.theme} == 'sgb-msu1' || ${system.theme} == 'sgb' ||
       ${system.theme} == 'snes-msu1' || ${system.theme} == 'snes' ||
       ${system.theme} == 'sufami' || ${system.theme} == 'supergrafx' ||
       ${system.theme} == 'vectrex' || ${system.theme} == 'virtualboy'">./_inc/media-fallback/cartridge.xml</include>
  <include if="${system.theme} == 'atarilynx' || ${system.theme} == 'gamate' ||
       ${system.theme} == 'gameandwatch' || ${system.theme} == 'gamecom' ||
       ${system.theme} == 'gamegear' || ${system.theme} == 'gb' ||
       ${system.theme} == 'gba' || ${system.theme} == 'gbc' ||
       ${system.theme} == 'nds' || ${system.theme} == 'ngp' ||
       ${system.theme} == 'ngpc' || ${system.theme} == 'pokemini' ||
       ${system.theme} == 'psp' || ${system.theme} == 'supervision' ||
       ${system.theme} == 'wonderswan' ||
       ${system.theme} == 'wonderswancolor'">./_inc/media-fallback/handheld-cart.xml</include>
  <include if="${system.theme} == 'atomiswave' || ${system.theme} == 'fbneo' ||
       ${system.theme} == 'mame' || ${system.theme} == 'namco22' ||
       ${system.theme} == 'naomi2' || ${system.theme} == 'neogeo'">./_inc/media-fallback/arcade-board.xml</include>

  <subset name="colorset" displayName="PSP Color">
    <include name="January Blue">./colors/psp-jan-blue.xml</include>
    <include name="February Violet">./colors/psp-feb-violet.xml</include>
    <include name="March Pink">./colors/psp-mar-pink.xml</include>
    <include name="April Green">./colors/psp-apr-green.xml</include>
    <include name="May Yellow-Green">./colors/psp-may-yellowgreen.xml</include>
    <include name="June Yellow">./colors/psp-jun-yellow.xml</include>
    <include name="July Amber">./colors/psp-jul-amber.xml</include>
    <include name="August Orange">./colors/psp-aug-orange.xml</include>
    <include name="September Red">./colors/psp-sep-red.xml</include>
    <include name="October Crimson">./colors/psp-oct-crimson.xml</include>
    <include name="November Slate">./colors/psp-nov-slate.xml</include>
    <include name="December Aqua">./colors/psp-dec-aqua.xml</include>
  </subset>

  <!-- v0.11 redesign: orthogonal subsets controlling the PSP-card row layout.
       Must appear BEFORE the gamelistStyle subset's includes so the variables
       they set (rowIconW/H, titleFontSize, metaFontSize,
       titleUnselectedY/Opacity, videoDelay) are resolved by the time the
       gamelist-*.xml style files are parsed. -->
  <subset name="iconSize" displayName="Icon Size">
    <include name="Boxart">./_inc/icon-size-boxart.xml</include>
    <include name="Compact">./_inc/icon-size-compact.xml</include>
  </subset>

  <subset name="titleVisibility" displayName="Title Visibility">
    <include name="PSP-Faithful">./_inc/title-visibility-strict.xml</include>
    <include name="With Titles">./_inc/title-visibility-friendly.xml</include>
  </subset>

  <!-- v0.11: videoDelay moved before gamelist include because subsets now
       set the ${videoDelay} variable (which gamelist.xml substitutes into
       tplVideo's <delay>) rather than writing directly into md_video. -->
  <subset name="videoDelay" displayName="Video Delay">
    <include name="5 seconds">./_inc/video-delay-5s.xml</include>
    <include name="Instant">./_inc/video-delay-instant.xml</include>
    <include name="2 seconds">./_inc/video-delay-2s.xml</include>
    <include name="10 seconds">./_inc/video-delay-10s.xml</include>
  </subset>

  <!-- v0.12: videoAudio moved here, into the variable-only group, when it
       was folded onto the real media slot. It now sets ${videoAudioEnabled},
       consumed by that element's <audio> property, instead of overriding a
       video element while it was hidden (a no-op). The slot is md_video
       itself as of #41, which changes nothing here — the coupling is through
       the variable, not the element name. Leaving it declared after the
       gamelistStyle subset would
       make it a no-op again — variables resolve at element-parse time, and
       the style views parse before anything declared later in this file. -->
  <subset name="videoAudio" displayName="Video Audio">
    <include name="Off">./_inc/video-audio-off.xml</include>
    <include name="On">./_inc/video-audio-on.xml</include>
  </subset>

  <!-- Aspect-ratio overrides load AFTER the mode subsets: both may set the
       same card variables (e.g. cardMetaFontSize), and per-ratio fit
       corrections must beat per-mode defaults. Before v0.11.1 these sat
       directly after common.xml, so icon-size-*.xml silently clobbered
       any per-ratio card override. Still before the view includes -
       variables resolve at element-parse time. -->
  <include if="${screen.ratio} == '8/7'">./_inc/aspect-8x7.xml</include>
  <include if="${screen.ratio} == '3/2'">./_inc/aspect-3x2.xml</include>
  <include if="${screen.ratio} == '16/9'">./_inc/aspect-16x9.xml</include>
  <include if="${screen.ratio} == '1/1'">./_inc/aspect-1x1.xml</include>

  <!-- The top-right status cluster. MUST parse after aspect-*.xml: its x
       positions are per-ratio variables and views resolve ${variables} at
       element-parse time, so declaring it in common.xml would silently pin
       every ratio to the 4:3 values. Same trap as the gamelist styles below. -->
  <include>./_inc/status-bar.xml</include>

  <!-- v0.12: the gamelist style subset. Each variant is a full <view>
       definition, so it MUST parse after aspect-*.xml — views resolve
       ${variables} at element-parse time, and a view parsed before the
       per-ratio overrides silently keeps the mode-subset defaults. This is
       the same last-write-wins trap that cost a debug cycle in v0.11.
       Each variant's root <theme defaultView="..."> selects the ES view
       type; see the header comment in each style file. -->
  <subset name="gamelistStyle" displayName="Gamelist Style">
    <include name="PSP Card">./_inc/gamelist-card.xml</include>
    <include name="List + Details">./_inc/gamelist-list.xml</include>
    <include name="Box Art Grid">./_inc/gamelist-grid.xml</include>
  </subset>

  <include>./_inc/system.xml</include>

  <!-- Friendly captions for ES collections. system.xml's systemName caption
       renders ${system.theme}; for a collection that is its theme-folder
       name, so the carousel read "AUTO-ALLGAMES" / "AUTO-FAVORITES" /
       "AUTO-LASTPLAYED". These must load AFTER system.xml — ES merges
       properties per view+element and the last declaration wins, so each
       file replaces only <text> and inherits the caption's geometry, font
       and forceUppercase. Real systems match no condition and keep
       ${system.theme}, so NES/SNES/PSX are unaffected. -->
  <include if="${system.theme} == 'auto-allgames'">./_inc/collection-name/auto-allgames.xml</include>
  <include if="${system.theme} == 'auto-favorites'">./_inc/collection-name/auto-favorites.xml</include>
  <include if="${system.theme} == 'auto-lastplayed'">./_inc/collection-name/auto-lastplayed.xml</include>
  <include if="${system.theme} == 'auto-neverplayed'">./_inc/collection-name/auto-neverplayed.xml</include>
  <include if="${system.theme} == 'auto-retroachievements'">./_inc/collection-name/auto-retroachievements.xml</include>

  <!-- Friendly caption for ES's synthetic group systems. A <group> that is not
       itself a system in es_systems.cfg makes ES fabricate a carousel entry
       whose name and theme folder are the raw group string. atari8bit is the
       only one on Knulli; batocera master also makes 'amiga' synthetic (it has
       an icon already, and AMIGA is a real product name). Same placement rule
       as the collection
       captions above — must load after system.xml to win the property merge. -->
  <include if="${system.theme} == 'atari8bit'">./_inc/group-name/atari8bit.xml</include>

  <include>./_inc/menu.xml</include>
  <include>./_inc/wave-motion.xml</include>

  <subset name="gamecount" displayName="Game Count">
    <include name="Hide">./_inc/gamecount-hide.xml</include>
    <include name="Show">./_inc/gamecount-show.xml</include>
  </subset>

  <!-- v0.10 pulled the Battery subset — see _inc/common.xml comment
       block for context. Will be re-introduced when the batteryIcon
       restoration ships. -->

  <subset name="scrollSpeed" displayName="Scroll Speed">
    <include name="Normal">./_inc/scroll-speed-normal.xml</include>
    <include name="Slow">./_inc/scroll-speed-slow.xml</include>
    <include name="Fast">./_inc/scroll-speed-fast.xml</include>
  </subset>
</theme>
