# Copy this to .env.local to override defaults.
# .env.local is gitignored.

DEVICE_IP=192.168.1.4
DEVICE_USER=root
THEME_NAME=es-theme-xmb-psp

# Knulli's /userdata partition is exFAT, so public-key SSH auth fails (dropbear
# rejects 0777 home directories). Set SSHPASS to the device's root password to
# route ssh/scp/rsync through sshpass. Requires:
#   brew install hudochenkov/sshpass/sshpass
# Default Knulli root password is "linux".
SSHPASS=linux
