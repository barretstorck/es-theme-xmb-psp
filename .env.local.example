# Copy this to .env.local to override defaults. .env.local is gitignored.
#
# Theme development uses the Docker render harness (scripts/render.sh — see
# docker/README.md), which needs no configuration here. Everything below is for
# the retired, dormant-fallback-only on-device scripts and the optional
# test-library fetch.

# --- on-device scripts (dormant fallback; not the routine workflow) ---
DEVICE_IP=192.168.1.4
DEVICE_USER=root
THEME_NAME=es-theme-xmb-psp

# Knulli's /userdata partition is exFAT, so public-key SSH auth fails (dropbear
# rejects 0777 home directories). Set SSHPASS to the device's root password to
# route ssh/scp/rsync through sshpass. Requires:
#   brew install hudochenkov/sshpass/sshpass
# Default Knulli root password is "linux".
SSHPASS=linux

# --- NAS (optional) — only needed to re-fetch the harness test library ---
# NAS_HOST=
# NAS_USER=
# NAS_PASS=
