<?xml version="1.0" encoding="UTF-8"?>
<!--
  es-theme-xmb-psp - "Icon Size: Compact".
  Smaller row icons + smaller fonts for users with long game lists who
  prefer to see more entries on screen.
  Selected via UI Settings > Theme Configuration > Icon Size > Compact.
  CC-BY-NC-SA 2.0. See CREDITS.md.
-->
<theme>
  <formatVersion>7</formatVersion>
  <variables>
    <!-- rowIconH is row-slot-relative (slot ~128px tall at 4:3); 0.50
         yields ~64px compact icons. See common.xml for sizing notes.
         rowIconCenterX = rowIconX + rowIconW/2 = 0.06 + 0.03 = 0.09. -->
    <rowIconW>0.06</rowIconW>
    <rowIconH>0.50</rowIconH>
    <rowIconCenterX>0.09</rowIconCenterX>
    <titleFontSize>0.026</titleFontSize>
    <metaFontSize>0.018</metaFontSize>
  </variables>
</theme>
