<?xml version="1.0" encoding="UTF-8"?>
<!--
  es-theme-xmb-psp - "Icon Size: Compact".
  Smaller selected boxart + peek icons + fonts for users who prefer a denser
  card. Keeps the v6 selected-dominates layout but scaled down.
  Selected via UI Settings > Theme Configuration > Icon Size > Compact.

  v0.11 v6 (PR #32): selected card boxart 165px (0.161 x 0.215), peek icons
  46px (0.045 width-cap / 0.272 slot-height). Dominance ratio preserved ~3.6x.
  CC-BY-NC-SA 2.0. See CREDITS.md.
-->
<theme>
  <formatVersion>7</formatVersion>
  <variables>
    <cardBoxartW>0.161</cardBoxartW>
    <cardBoxartH>0.215</cardBoxartH>
    <cardTextX>0.345</cardTextX>
    <cardTextW>0.625</cardTextW>
    <cardLineW>0.625</cardLineW>
    <cardTitleFontSize>0.060</cardTitleFontSize>
    <cardMetaFontSize>0.026</cardMetaFontSize>
    <cardDescX>0.58</cardDescX>
    <cardDescW>0.39</cardDescW>
    <peekIconW>0.045</peekIconW>
    <peekIconH>0.272</peekIconH>
    <peekTextX>0.275</peekTextX>
    <peekTitleFontSize>0.026</peekTitleFontSize>
  </variables>
</theme>
