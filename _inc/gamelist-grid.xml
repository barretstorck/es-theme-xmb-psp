<?xml version="1.0" encoding="UTF-8"?>
<!--
  v0.12 gamelist style D — Box Art Grid. One of three mutually-exclusive
  style files selected by the "gamelistStyle" subset in theme.xml; exactly one
  is ever included, so element names cannot collide across styles.

  A wall of box art with a bound info bar beneath, modelled on
  Meringue_Knulli. No text list at all — the art is the list. Uses
  <imagegrid>/<gridtile>, which GridGameListView renders instead of the
  textlist-based views styles A/B use. See the approved mockup
  docs/screenshots/v0.12-gamelist-mockups/d-boxart-grid.png.

  The root defaultView attribute is what selects the ES view type:
  ThemeData::appendFile() runs parseTheme() on every include, and parseTheme()
  reads defaultView (ThemeData.cpp:1329). ViewController substitutes it when
  the user's GamelistViewStyle is "automatic", or names a view this style does
  not define (ViewController.cpp:697-720).

  GridGameListView derives from ISimpleGameListView and calls
  updateThemeExtrasBindings() (GridGameListView.cpp:228), so the extra="true"
  info-bar elements below rebind to the selected tile on cursor change exactly
  as in the other views.

  The waveLayer elements below are duplicated verbatim from
  _inc/wave-motion.xml ON PURPOSE. Knulli build quirk: storyboard-animated
  extra="true" elements declared only in that include do not animate on
  gamelist views. Do not "clean up" the duplication.

  CC-BY-NC-SA 2.0. See CREDITS.md.
-->
<theme defaultView="grid">
  <formatVersion>7</formatVersion>

  <view name="grid">

    <!-- Shared chrome, duplicated verbatim from _inc/common.xml's
         <view name="system,detailed,gamecarousel,menu"> block. It lives here
         rather than in that shared list ON PURPOSE: adding "grid" there makes
         hasView("grid") true even when this style is not selected, which
         hijacks a user who pinned ES's Gamelist View Style to "grid" into an
         unstyled built-in grid. Declaring it here registers the grid view only
         when this style is active. Keep in sync with common.xml. -->
    <sound name="systemscroll">
      <path>${soundNavigate}</path>
    </sound>
    <sound name="scroll">
      <path>${soundNavigate}</path>
    </sound>
    <sound name="select">
      <path>${soundSelect}</path>
    </sound>
    <sound name="back">
      <path>${soundBack}</path>
    </sound>
    <helpsystem name="help">
      <pos>0.02 0.94</pos>
      <textColor>${textPrimary}</textColor>
      <iconColor>${helpAccent}</iconColor>
      <fontPath>${fontRegular}</fontPath>
      <fontSize>0.025</fontSize>
      <!-- Button glyphs (audit S4, #8). The four face-button slots come from
           the buttonGlyphs subset (_inc/buttons-{nintendo,psp,xbox}.xml); the
           rest are layout-independent and shared by all three sets.

           Slots are nailed to PHYSICAL positions, not to letters:
           iconA=EAST, iconB=SOUTH, iconX=NORTH, iconY=WEST. The derivation is
           in _inc/buttons-nintendo.xml. Get it wrong and nothing errors - the
           glyphs just land on the wrong buttons.

           A path that does not resolve is equally silent: HelpComponent.cpp's
           updateGrid() only uses the themed icon when
           ResourceManager::fileExists() passes, and otherwise falls back to
           ES's built-in :/help/*.svg. A typo therefore looks exactly like
           broken art. scripts/tests/test-button-glyphs.sh checks every path
           in this block exists on disk.

           There is no iconLR slot - ES's helpsystem property map
           (ThemeData.cpp:493-514) has 12 icon properties and the "lr" prompt
           is not among them, so that one prompt keeps ES's stock glyph. -->
      <iconA>${helpIconA}</iconA>
      <iconB>${helpIconB}</iconB>
      <iconX>${helpIconX}</iconX>
      <iconY>${helpIconY}</iconY>
      <iconUpDown>./art/help/dpad-updown.png</iconUpDown>
      <iconLeftRight>./art/help/dpad-leftright.png</iconLeftRight>
      <iconUpDownLeftRight>./art/help/dpad-all.png</iconUpDownLeftRight>
      <iconL>./art/help/shoulder-l.png</iconL>
      <iconR>./art/help/shoulder-r.png</iconR>
      <iconStart>./art/help/btn-start.png</iconStart>
      <iconSelect>./art/help/btn-select.png</iconSelect>
      <iconF1>./art/help/key-f1.png</iconF1>
    </helpsystem>

    <!-- Wave background. extra="true" required to render. -->
    <image name="waveBackground" extra="true">
      <path>./art/wave/wave.png</path>
      <pos>0.5 0.5</pos>
      <size>1.10 1.10</size>
      <origin>0.5 0.5</origin>
      <color>${waveTint}</color>
      <zIndex>0</zIndex>
    </image>

    <!-- KNULLI BUILD QUIRK: storyboard-animated extra="true" elements
         declared only inside _inc/wave-motion.xml do not animate on
         gamelist views on this Knulli ES build. The three waveLayer
         declarations below are duplicated verbatim from
         _inc/wave-motion.xml so they sit directly in the view block. -->
    <image name="waveLayer1" extra="true">
      <path>./art/wave/wave-layer-1.png</path>
      <pos>0.0 0.5</pos>
      <size>2.00 1.10</size>
      <origin>0.0 0.5</origin>
      <color>${accent}</color>
      <opacity>0.85</opacity>
      <zIndex>1</zIndex>
      <storyboard>
        <animation property="x" from="0.0" to="-1.0"
                   duration="30000" mode="linear"
                   repeat="forever"/>
      </storyboard>
    </image>
    <image name="waveLayer2" extra="true">
      <path>./art/wave/wave-layer-2.png</path>
      <pos>0.0 0.5</pos>
      <size>2.00 1.10</size>
      <origin>0.0 0.5</origin>
      <color>${accent}</color>
      <opacity>0.85</opacity>
      <zIndex>2</zIndex>
      <storyboard>
        <animation property="x" from="0.0" to="-1.0"
                   duration="20000" mode="linear"
                   repeat="forever"/>
      </storyboard>
    </image>
    <image name="waveLayer3" extra="true">
      <path>./art/wave/wave-layer-3.png</path>
      <pos>0.0 0.5</pos>
      <size>2.00 1.10</size>
      <origin>0.0 0.5</origin>
      <color>${accent}</color>
      <opacity>0.85</opacity>
      <zIndex>3</zIndex>
      <storyboard>
        <animation property="x" from="0.0" to="-1.0"
                   duration="12000" mode="linear"
                   repeat="forever"/>
      </storyboard>
    </image>

    <text name="gridSystemName" extra="true">
      <pos>0.03 0.028</pos>
      <size>0.50 0.06</size>
      <origin>0 0</origin>
      <fontPath>${fontLight}</fontPath>
      <fontSize>0.040</fontSize>
      <color>${textSecondary}</color>
      <text>${system.fullName}</text>
      <alignment>left</alignment>
      <forceUppercase>true</forceUppercase>
      <multiLine>false</multiLine>
      <zIndex>6</zIndex>
    </text>

    <!-- Geometry (issue #43). The tiles occupy a fixed CELL BAND of
         0.04 0.16 0.92 0.60 - unchanged since v0.12. The rect declared here is
         that band grown by the zoom overhang on every side, with <padding>
         equal to the growth:

           tile      = (band - margin * (n - 1)) / n
                     = 0.2120 wide x 0.2840 high
           overhang  = (zoom - 1) * tile / 2   -> 0.0212 x 0.0284
           pos       = band origin - overhang
           size      = band size   + 2 * overhang

         Two separate ES behaviours force this shape:

         * The grid rect is its own render clip - render() pushes it before
           drawing any tile (ImageGridComponent.h:733). Without the growth the
           selected tile in the top row is CUT FLAT at the band edge: measured
           254x238 instead of 254x254 at zoom 1.14, i.e. the shipped v0.12
           value was already being clipped.
         * <padding> is subtracted before the tile size is derived, and added
           to the first tile's centre (:1444 and :283). So growing the rect and
           padding by the same amount leaves tile size and cell positions bit
           for bit unchanged - the grown rect is purely extra clip room.

         The margin is what buys NEIGHBOUR clearance, and it is the binding
         constraint on the zoom. Clearance between the enlarged tile and its
         neighbour is (tile + margin) - tile * (zoom + 1) / 2, so the smallest
         margin that avoids contact is

           margin_min = (zoom - 1) * W_band / 2 / (n + (n - 1) * (zoom - 1) / 2)

         = 0.0214 horizontally and 0.0286 vertically at zoom 1.20. v0.12's
         0.012/0.020 put the ceiling at zoom 1.109 horizontally and 1.138
         vertically, so its 1.14 was ALREADY PAST the horizontal one: tile
         boxes overlapped by 3.6px at 1024 wide.

         That overlap was invisible, and the reason is worth knowing before
         retuning: maxSize-fit art is narrower than its own cell whenever the
         art is not exactly the cell's aspect, so the DRAWN art had clearance
         the boxes did not. Square-ish Game Boy covers in a 226x223 cell drew
         222px wide and cleared until zoom 1.146. Art that fills its cell in
         the binding axis - the worst case, and the only safe one to design
         against - collides at 1.109. The formula above and
         scripts/tests/test-grid-selection.sh both use the box, not the art.

         The
         values below clear margin_min by 0.0028/0.0036 - about 3px at
         1024x768 - deliberately, since a threshold-exact margin leaves the
         gutter a sub-pixel wide and anti-aliases into contact. The cost is a
         tile 4.1% narrower and 2.1% shorter than v0.12's.

         Every number is a fraction of the same screen dimension, so these
         thresholds are IDENTICAL at all five aspect ratios - no per-ratio
         override is needed or wanted. scripts/tests/test-grid-selection.sh
         recomputes all of it and fails on any inconsistency. -->
    <imagegrid name="gamegrid">
      <pos>0.0188 0.1316</pos>
      <size>0.9624 0.6568</size>
      <padding>0.0212 0.0284 0.0212 0.0284</padding>
      <margin>0.024 0.032</margin>
      <scrollDirection>vertical</scrollDirection>
      <autoLayout>4 2</autoLayout>
      <!-- Real properties on this build (ThemeData.cpp imagegrid map);
           this is how the selected tile grows, not a hand-rolled border. It is
           also the ONLY selection cue: see the gridtile block below. -->
      <autoLayoutSelectedZoom>1.20</autoLayoutSelectedZoom>
      <animateSelection>true</animateSelection>
      <zIndex>5</zIndex>
    </imagegrid>

    <!-- imageSizeMode=maxSize keeps non-square box art undistorted;
         selectionMode=image scopes the selector to the artwork. -->
    <!-- GridTileComponent looks these up by the element NAMES "default" and
         "selected" (GridTileComponent.cpp:797,806). An unnamed <gridtile>
         is not the same thing — name it explicitly. -->
    <!-- Selection is SIZE ONLY (issue #43): unselected tiles are not dimmed,
         and the selected one gets no fill. Both properties below are explicit
         on purpose.

         imageColor FFFFFFFF on "default" replaces v0.12's FFFFFF9E, whose 62%
         alpha faded every unselected tile.

         backgroundColor must be set to a TRANSPARENT value rather than simply
         deleted. Omitting it does not remove the background: the nine-patch
         falls back to :/frame.png, tinted 0xAAAAEEFF on the default tile and
         0xFFFFFFFF on the selected one, because resetProperties assigns that
         pale tint to mDefaultProperties alone (GridTileComponent.cpp:67) and
         renderBackground() draws unconditionally (:325). Deleting the property
         would therefore have swapped the coloured box for a white frame glow.

         "selected" repeats the transparent background because the theme lookup
         applies the "default" element to BOTH property sets and then the
         "selected" element to the selected set (GridTileComponent.cpp:797-807)
         - so anything selected-only must be restated here, and anything the
         selected state should share is inherited. backgroundCornerSize is gone
         with the box it rounded. -->
    <gridtile name="default">
      <!-- Inert while <autoLayout> is set; see the note on gridTileW in
           _inc/common.xml. Kept as the fallback if autoLayout ever goes. -->
      <size>${gridTileW} ${gridTileH}</size>
      <padding>0.008 0.008 0.008 0.008</padding>
      <selectionMode>image</selectionMode>
      <imageSizeMode>maxSize</imageSizeMode>
      <imageColor>FFFFFFFF</imageColor>
      <backgroundColor>FFFFFF00</backgroundColor>
    </gridtile>
    <gridtile name="selected">
      <imageColor>FFFFFFFF</imageColor>
      <backgroundColor>FFFFFF00</backgroundColor>
    </gridtile>

    <!-- Info bar. GridGameListView derives from ISimpleGameListView and calls
         updateThemeExtrasBindings() (GridGameListView.cpp:228), so these
         {game:*} extras rebind to the selected tile on cursor change. -->
    <!-- The fill MUST be panel-fill.png, not line-1px.png (issue #43).
         line-1px.png is 256x4 with rows 0 and 3 fully transparent - bleed rows
         that keep it a crisp hairline where it is used as a rule, as in style
         A's cardLine and style B's listRule. Stretched to a 0.110-tall panel,
         only its opaque middle band drew: measured 0.8229-0.8776 against the
         0.795-0.905 declared here, i.e. half height, vertically centred, with
         soft edges. gridMeta ends at 0.902 and so fell outside the bar
         entirely. That was the whole "the box does not wrap its text" report;
         no geometry was wrong. -->
    <image name="gridInfoPanel" extra="true">
      <path>./art/ui/panel-fill.png</path>
      <pos>0.03 ${gridInfoY}</pos>
      <size>0.94 ${gridInfoH}</size>
      <origin>0 0</origin>
      <color>000000</color>
      <opacity>0.40</opacity>
      <zIndex>7</zIndex>
    </image>

    <text name="gridTitle" extra="true">
      <pos>0.05 ${gridTitleY}</pos>
      <size>0.90 ${gridTitleH}</size>
      <origin>0 0</origin>
      <fontPath>${fontRegular}</fontPath>
      <fontSize>0.046</fontSize>
      <color>${textPrimary}</color>
      <text>{game:name}</text>
      <alignment>left</alignment>
      <multiLine>false</multiLine>
      <!-- No clip rect here, deliberately. Issue #43 reported that a long
           title "runs to the screen edge and past the box" and asked for one,
           but a SINGLE-LINE, non-scrolling text is already bounded by <size>:
           ES abbreviates it to mSize.x with "..." (TextComponent.cpp:376-379).
           Verified - adding one changes zero pixels. The 89-char
           nes/long-title fixture ends "...Sky Dra..." at 0.95, inside the
           panel's 0.97, on the strength of <size> alone.

           The theme's "<size> alone does NOT clip" rule is about MULTI-LINE
           text: cardDesc and listDesc overflow their box VERTICALLY, which
           <size> does not bound, and that is what their clip rects are for.

           What actually escaped the box was the BOX: the panel drew at half
           height (see gridInfoPanel), so this band's top at 0.808 sat above
           the visible bar top at 0.8229.

           The abbreviation is gated on mAutoScroll == NONE (:376). So IF a
           marquee is ever added here, abbreviation stops and a clip rect
           becomes the only bound - add one in the same commit.
           test-grid-selection.sh enforces that pairing. -->
      <!-- emptyTextDefaults=false: TextComponent.cpp:625 defaults extra="true"
           text bindings to substitute "Unknown"/"None" for an empty binding
           (BindingManager.cpp:126), regardless of ThemeData.cpp:252's comment
           claiming the default is false. Disabled here so an unscraped game's
           empty {game:*} fields render blank instead of a fake "Unknown". -->
      <emptyTextDefaults>false</emptyTextDefaults>
      <zIndex>8</zIndex>
    </text>

    <text name="gridMeta" extra="true">
      <pos>0.05 ${gridMetaY}</pos>
      <size>0.60 ${gridMetaH}</size>
      <origin>0 0</origin>
      <fontPath>${fontLight}</fontPath>
      <fontSize>0.027</fontSize>
      <color>${textSecondary}</color>
      <text>{game:genre}  ·  {game:releaseyear}  ·  {game:developer}  ·  {game:playercount}P</text>
      <alignment>left</alignment>
      <multiLine>false</multiLine>
      <!-- <size> 0.60 is what keeps this run out of the star column at
           gridStarX 0.680: no clause here has a length limit, and a long
           genre + developer pair would otherwise reach it. v0.12 also carried
           a clip rect on the same rect; #43 removed it as inert, for the
           reason spelled out on gridTitle above - ES abbreviates a
           single-line text to mSize.x, so the clip rect could never be the
           binding constraint. Removing it changed the band by at most one
           LSB. -->
      <emptyTextDefaults>false</emptyTextDefaults>
      <zIndex>8</zIndex>
    </text>

    <!-- Rating: a dim five-glyph track with the bound value drawn over it.
         The pair must keep identical pos, size, font and alignment or the
         filled glyphs drift off the track - {game:stars} emits FILLED glyphs
         only (FileData.cpp:1924), so the track supplies the empty ones.

         <size> gridStarW is the bound issue #43 asked for. It changes no
         pixels today: the track is a fixed five-glyph literal about 0.09
         wide, well inside 0.140. It is the property that WOULD bound them,
         which is the point - nothing structural did before. -->
    <text name="gridStarTrack" extra="true">
      <pos>${gridStarX} ${gridMetaY}</pos>
      <size>${gridStarW} ${gridMetaH}</size>
      <origin>0 0</origin>
      <fontPath>${fontLight}</fontPath>
      <fontSize>0.027</fontSize>
      <color>${textSecondary}</color>
      <opacity>0.35</opacity>
      <text>&#xF005;&#xF005;&#xF005;&#xF005;&#xF005;</text>
      <alignment>left</alignment>
      <zIndex>8</zIndex>
    </text>
    <text name="gridStars" extra="true">
      <pos>${gridStarX} ${gridMetaY}</pos>
      <size>${gridStarW} ${gridMetaH}</size>
      <origin>0 0</origin>
      <fontPath>${fontLight}</fontPath>
      <fontSize>0.027</fontSize>
      <color>${textPrimary}</color>
      <text>{game:stars}</text>
      <alignment>left</alignment>
      <emptyTextDefaults>false</emptyTextDefaults>
      <zIndex>9</zIndex>
    </text>

    <!-- Suppress ES's built-in metadata elements (md_*). The card above
         replaces the default right info panel, so the default rendering of
         md_name / md_rating / md_video / md_image / md_description would
         otherwise paint in unstyled locations. -->
    <text name="md_name"><visible>false</visible></text>
    <text name="md_description"><visible>false</visible></text>
    <text name="md_developer"><visible>false</visible></text>
    <text name="md_publisher"><visible>false</visible></text>
    <text name="md_genre"><visible>false</visible></text>
    <text name="md_players"><visible>false</visible></text>
    <text name="md_lbl_rating"><visible>false</visible></text>
    <text name="md_lbl_releasedate"><visible>false</visible></text>
    <text name="md_lbl_developer"><visible>false</visible></text>
    <text name="md_lbl_publisher"><visible>false</visible></text>
    <text name="md_lbl_genre"><visible>false</visible></text>
    <text name="md_lbl_players"><visible>false</visible></text>
    <text name="md_lbl_lastplayed"><visible>false</visible></text>
    <text name="md_lbl_playcount"><visible>false</visible></text>
    <text name="md_releasedate"><visible>false</visible></text>
    <text name="md_lastplayed"><visible>false</visible></text>
    <text name="md_playcount"><visible>false</visible></text>
    <datetime name="md_releasedate"><visible>false</visible></datetime>
    <datetime name="md_lastplayed"><visible>false</visible></datetime>
    <rating name="md_rating"><visible>false</visible></rating>
    <image name="md_image"><visible>false</visible></image>
    <image name="md_thumbnail"><visible>false</visible></image>
    <image name="md_marquee"><visible>false</visible></image>
    <video name="md_video"><visible>false</visible></video>

  </view>
</theme>
