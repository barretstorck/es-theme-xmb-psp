<?xml version="1.0" encoding="UTF-8"?>
<!--
  v0.12 gamelist style B — List + Details. One of three mutually-exclusive
  style files selected by the "gamelistStyle" subset in theme.xml; exactly one
  is ever included, so element names cannot collide across styles.

  Conventional ten-row title list with art, metadata and description on the
  right, modelled on es-theme-PlayStation-X (see the approved mockup
  docs/screenshots/v0.12-gamelist-mockups/b-playstation-x.png). Deliberately
  does NOT use the XMB cross/peek column that style A (gamelist-card.xml)
  uses — the wave background and colorset are what keep it part of the
  theme.

  The root defaultView attribute is what selects the ES view type:
  ThemeData::appendFile() runs parseTheme() on every include, and parseTheme()
  reads defaultView (ThemeData.cpp:1329). ViewController substitutes it when
  the user's GamelistViewStyle is "automatic", or names a view this style does
  not define (ViewController.cpp:697-720).

  The waveLayer elements below are duplicated verbatim from
  _inc/wave-motion.xml ON PURPOSE. Knulli build quirk: storyboard-animated
  extra="true" elements declared only in that include do not animate on
  gamelist views. Do not "clean up" the duplication.

  CC-BY-NC-SA 2.0. See CREDITS.md.
-->
<theme defaultView="detailed">
  <formatVersion>7</formatVersion>

  <view name="detailed,gamecarousel">

    <!-- Wave background. extra="true" required to render. -->
    <image name="waveBackground" extra="true">
      <path>./art/wave/wave.png</path>
      <pos>0.5 0.5</pos>
      <size>1.10 1.10</size>
      <origin>0.5 0.5</origin>
      <color>${waveTint}</color>
      <zIndex>0</zIndex>
    </image>

    <!-- KNULLI BUILD QUIRK: storyboard-animated extra="true" elements
         declared only inside _inc/wave-motion.xml do not animate on
         gamelist views on this Knulli ES build. The three waveLayer
         declarations below are duplicated verbatim from
         _inc/wave-motion.xml so they sit directly in the view block. -->
    <image name="waveLayer1" extra="true">
      <path>./art/wave/wave-layer-1.png</path>
      <pos>0.0 0.5</pos>
      <size>2.00 1.10</size>
      <origin>0.0 0.5</origin>
      <color>${accent}</color>
      <opacity>0.85</opacity>
      <zIndex>1</zIndex>
      <storyboard>
        <animation property="x" from="0.0" to="-1.0"
                   duration="30000" mode="linear"
                   repeat="forever"/>
      </storyboard>
    </image>
    <image name="waveLayer2" extra="true">
      <path>./art/wave/wave-layer-2.png</path>
      <pos>0.0 0.5</pos>
      <size>2.00 1.10</size>
      <origin>0.0 0.5</origin>
      <color>${accent}</color>
      <opacity>0.85</opacity>
      <zIndex>2</zIndex>
      <storyboard>
        <animation property="x" from="0.0" to="-1.0"
                   duration="20000" mode="linear"
                   repeat="forever"/>
      </storyboard>
    </image>
    <image name="waveLayer3" extra="true">
      <path>./art/wave/wave-layer-3.png</path>
      <pos>0.0 0.5</pos>
      <size>2.00 1.10</size>
      <origin>0.0 0.5</origin>
      <color>${accent}</color>
      <opacity>0.85</opacity>
      <zIndex>3</zIndex>
      <storyboard>
        <animation property="x" from="0.0" to="-1.0"
                   duration="12000" mode="linear"
                   repeat="forever"/>
      </storyboard>
    </image>

    <text name="listSystemName" extra="true">
      <pos>0.03 0.022</pos>
      <size>0.60 0.08</size>
      <origin>0 0</origin>
      <fontPath>${fontBold}</fontPath>
      <fontSize>0.050</fontSize>
      <color>${textPrimary}</color>
      <text>${system.fullName}</text>
      <alignment>left</alignment>
      <forceUppercase>true</forceUppercase>
      <multiLine>false</multiLine>
      <zIndex>6</zIndex>
    </text>

    <image name="listRule" extra="true">
      <path>./art/line-1px.png</path>
      <pos>0.03 0.108</pos>
      <size>0.94 0.002</size>
      <origin>0 0.5</origin>
      <color>${textPrimary}</color>
      <opacity>0.35</opacity>
      <zIndex>6</zIndex>
    </image>

    <!-- Real 10-row title list. Unlike the card style's transparent peek
         list, this textlist renders its own text. -->
    <textlist name="gamelist">
      <pos>0.025 0.135</pos>
      <size>0.50 0.685</size>
      <lines>10</lines>
      <fontPath>${fontRegular}</fontPath>
      <fontSize>0.040</fontSize>
      <primaryColor>${textSecondary}</primaryColor>
      <secondaryColor>${textSecondary}</secondaryColor>
      <selectedColor>${textPrimary}</selectedColor>
      <!-- v0.12 bugfix (caught in render verification, not the brief's spec):
           selectorColor as plain ${textPrimary} (opaque FFFFFF) paints a solid
           white bar UNDER the row text, and selectedColor is ALSO
           ${textPrimary} — so the selected row's title was invisible,
           white-on-white. ES applies alpha for 8-hex colors, so a translucent
           highlight needs an explicit alpha suffix (precedent:
           _inc/menu.xml's "${waveTint}F0"). Spec §5 pins ~30% opacity ->
           hex 4D (77/255 = 30.2%); an earlier pass mistakenly derived 30 hex
           (48/255 = 18.8%) from sampling the mockup's rendered pixels instead
           of converting the spec's stated percentage. -->
      <selectorColor>${textPrimary}4D</selectorColor>
      <selectorHeight>0.058</selectorHeight>
      <alignment>left</alignment>
      <horizontalMargin>0.02</horizontalMargin>
      <zIndex>5</zIndex>
    </textlist>

    <!-- Media fallback when the selected game has no screenshot. Style B has
         no other art slot, so without this an unscraped game leaves the whole
         right half of the screen empty. -->
    <image name="listMediaFallback" extra="true">
      <path>${mediaFallbackPath}</path>
      <pos>${listMediaX} ${listMediaY}</pos>
      <maxSize>${listMediaW} ${listMediaH}</maxSize>
      <origin>0.5 0.5</origin>
      <visible>!exists({game:image})</visible>
      <zIndex>6</zIndex>
    </image>

    <!-- The media slot itself is md_video, in the metadata block below. It is
         NOT an extra: see the comment there (#41). -->

    <!-- listYearDev / listMeta merge two semantically distinct fields
         (year+developer, players+genre) into one single-coloured <text>
         each: ES has no inline multi-colour text run, so a single <color>
         is the only option here. -->
    <text name="listYearDev" extra="true">
      <pos>0.575 0.505</pos>
      <size>0.395 0.04</size>
      <origin>0 0</origin>
      <fontPath>${fontRegular}</fontPath>
      <fontSize>0.030</fontSize>
      <!-- selectorGlow, NOT accent: accent is the wave-layer tint, so accent
           text on the wave is blue-on-blue. The approved mockup used glow. -->
      <color>${selectorGlow}</color>
      <text>{game:releaseyear}  •  {game:developer}</text>
      <alignment>left</alignment>
      <multiLine>false</multiLine>
      <!-- emptyTextDefaults=false: TextComponent.cpp:625 defaults extra="true"
           text bindings to substitute "Unknown"/"None" for an empty binding
           (BindingManager.cpp:126), regardless of ThemeData.cpp:252's comment
           claiming the default is false. Disabled here so an unscraped game's
           empty {game:*} fields render blank instead of a fake "Unknown". -->
      <emptyTextDefaults>false</emptyTextDefaults>
      <zIndex>8</zIndex>
    </text>

    <!-- Same track-behind-stars pattern as style A; see gamelist-card.xml
         for why {game:stars} needs it. -->
    <text name="listStarTrack" extra="true">
      <pos>${listStarX} 0.548</pos>
      <origin>0 0</origin>
      <fontPath>${fontLight}</fontPath>
      <fontSize>0.028</fontSize>
      <color>${textSecondary}</color>
      <opacity>0.35</opacity>
      <text>&#xF005;&#xF005;&#xF005;&#xF005;&#xF005;</text>
      <alignment>left</alignment>
      <zIndex>7</zIndex>
    </text>
    <text name="listStars" extra="true">
      <pos>${listStarX} 0.548</pos>
      <origin>0 0</origin>
      <fontPath>${fontLight}</fontPath>
      <fontSize>0.028</fontSize>
      <color>${textPrimary}</color>
      <text>{game:stars}</text>
      <alignment>left</alignment>
      <emptyTextDefaults>false</emptyTextDefaults>
      <zIndex>8</zIndex>
    </text>

    <text name="listMeta" extra="true">
      <pos>${listMetaX} 0.548</pos>
      <size>0.27 0.04</size>
      <origin>0 0</origin>
      <fontPath>${fontLight}</fontPath>
      <fontSize>0.028</fontSize>
      <color>${selectorGlow}</color>
      <text>{game:playercount}P  •  {game:genre}</text>
      <alignment>left</alignment>
      <multiLine>false</multiLine>
      <emptyTextDefaults>false</emptyTextDefaults>
      <zIndex>8</zIndex>
    </text>

    <text name="listDesc" extra="true">
      <pos>0.575 ${listDescY}</pos>
      <size>0.395 ${listDescH}</size>
      <origin>0 0</origin>
      <fontPath>${fontLight}</fontPath>
      <fontSize>0.024</fontSize>
      <color>${textSecondary}</color>
      <text>{game:desc}</text>
      <alignment>left</alignment>
      <verticalAlignment>top</verticalAlignment>
      <!-- Scrolls inside its bounds, same as style A's cardDesc — see the long
           note there for why <autoScroll> is required before the Scroll Speed
           subset's <autoScrollSpeed> does anything, and why a clipRect does
           not suppress the scroll. Cadence is owned by the subset. -->
      <autoScroll>vertical</autoScroll>
      <!-- <size> alone does NOT clip on this build — style A (cardDesc) proved
           that. clipRect is normalized SCREEN coords (x y w h), scaled by
           screenScale and pushed as a render clip (GuiComponent.cpp:885,
           1269). -->
      <clipRect>0.575 ${listDescY} 0.395 ${listDescH}</clipRect>
      <emptyTextDefaults>false</emptyTextDefaults>
      <zIndex>8</zIndex>
    </text>

    <!-- Suppress ES's built-in metadata elements (md_*). The elements above
         replace the default right info panel, so the default rendering of
         md_name / md_rating / md_video / md_image / md_description would
         otherwise paint in unstyled locations. -->
    <text name="md_name"><visible>false</visible></text>
    <text name="md_description"><visible>false</visible></text>
    <text name="md_developer"><visible>false</visible></text>
    <text name="md_publisher"><visible>false</visible></text>
    <text name="md_genre"><visible>false</visible></text>
    <text name="md_players"><visible>false</visible></text>
    <text name="md_lbl_rating"><visible>false</visible></text>
    <text name="md_lbl_releasedate"><visible>false</visible></text>
    <text name="md_lbl_developer"><visible>false</visible></text>
    <text name="md_lbl_publisher"><visible>false</visible></text>
    <text name="md_lbl_genre"><visible>false</visible></text>
    <text name="md_lbl_players"><visible>false</visible></text>
    <text name="md_lbl_lastplayed"><visible>false</visible></text>
    <text name="md_lbl_playcount"><visible>false</visible></text>
    <text name="md_releasedate"><visible>false</visible></text>
    <text name="md_lastplayed"><visible>false</visible></text>
    <text name="md_playcount"><visible>false</visible></text>
    <datetime name="md_releasedate"><visible>false</visible></datetime>
    <datetime name="md_lastplayed"><visible>false</visible></datetime>
    <rating name="md_rating"><visible>false</visible></rating>
    <image name="md_image"><visible>false</visible></image>
    <image name="md_thumbnail"><visible>false</visible></image>
    <image name="md_marquee"><visible>false</visible></image>
    <!-- THE MEDIA SLOT (right half). md_video, not an extra — the still and
         the clip have to be one component or their <maxSize> rectangles differ
         and the still's edges survive around the video. Full reasoning and the
         ES source references are in _inc/gamelist-card.xml (#41).

         listMediaFallback above still covers the no-screenshot case. -->
    <video name="md_video">
      <pos>${listMediaX} ${listMediaY}</pos>
      <maxSize>${listMediaW} ${listMediaH}</maxSize>
      <origin>0.5 0.5</origin>
      <snapshotSource>image</snapshotSource>
      <showSnapshotDelay>true</showSnapshotDelay>
      <showSnapshotNoVideo>true</showSnapshotNoVideo>
      <delay>${videoDelay}</delay>
      <audio>${videoAudioEnabled}</audio>
      <zIndex>8</zIndex>
    </video>

  </view>
</theme>
