<?xml version="1.0" encoding="UTF-8"?>
<!--
  es-theme-xmb-psp - menu view (panel + list text follow the active colorset).
  CC-BY-NC-SA 2.0. See CREDITS.md.
-->
<theme>
  <formatVersion>7</formatVersion>

  <view name="menu">

    <!-- Panel background: a near-opaque colorset tint (F0 alpha) so the menu
         reads as part of the PSP theme instead of ES's stock white chrome. -->
    <menuBackground name="menubg">
      <color>${waveTint}F0</color>
    </menuBackground>

    <!-- Menu rows (main menu list + sub-screen list items): light text,
         colorset accent on the selection bar. -->
    <menuText name="menutext">
      <color>${textPrimary}</color>
      <selectedColor>${textPrimary}</selectedColor>
      <selectorColor>${accent}</selectorColor>
    </menuText>

    <!-- Sub-screen section-header labels (e.g. "VOLUME", "MUSIC"). -->
    <menuTextSmall name="menutextsmall">
      <color>${textPrimary}</color>
    </menuTextSmall>

    <!-- NOTE: menuTitle and menuFooter are intentionally NOT themed here.
         The Task 5 spike found they do not respond to <color> on this Knulli
         build, so the menu title and footer keep ES's default colour.
         menuSwitch/menuSlider/menuButton are likewise not themeable without
         image assets. See the spec's "Change 7 - spike findings". -->

  </view>
</theme>
