<?xml version="1.0" encoding="UTF-8"?>
<!--
  es-theme-xmb-psp - "Icon Size: Boxart" (default).
  Larger selected boxart + peek icons for users with scraped boxart they want
  to see. Selected via UI Settings > Theme Configuration > Icon Size > Boxart.

  v0.11 v6 (PR #32): selected card boxart 240px (0.234 x 0.3125), peek icons
  65px (0.063 width-cap / 0.385 slot-height). Selected-to-peek ratio ~3.7x.
  CC-BY-NC-SA 2.0. See CREDITS.md.
-->
<theme>
  <formatVersion>7</formatVersion>
  <variables>
    <cardBoxartW>0.234</cardBoxartW>
    <cardBoxartH>0.3125</cardBoxartH>
    <cardTextX>0.385</cardTextX>
    <cardTextW>0.585</cardTextW>
    <cardLineW>0.585</cardLineW>
    <cardTitleFontSize>0.075</cardTitleFontSize>
    <cardMetaFontSize>0.030</cardMetaFontSize>
    <cardDescX>0.62</cardDescX>
    <cardDescW>0.35</cardDescW>
    <peekIconW>0.063</peekIconW>
    <peekIconH>0.385</peekIconH>
    <peekTextX>0.30</peekTextX>
    <peekTitleFontSize>0.030</peekTitleFontSize>
  </variables>
</theme>
