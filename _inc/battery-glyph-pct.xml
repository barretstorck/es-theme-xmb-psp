<?xml version="1.0" encoding="UTF-8"?>
<!--
  es-theme-xmb-psp - Battery: Glyph + Percentage subset (v0.10).
  Shows the battery glyph (from common.xml) plus a numeric percentage
  immediately to its left. Both render whenever the device reports a
  battery; both auto-hide on devices without one.

  Shifts the clock leftward so its right edge clears the percentage
  element's left edge — the v0.9.3 clock at pos.x=0.78 collides
  with the new percentage's left edge at pos.x=0.88.

  CC-BY-NC-SA 2.0. See CREDITS.md.
-->
<theme>
  <formatVersion>7</formatVersion>
  <view name="screen">
    <!-- Numeric percentage to the LEFT of the battery glyph.
         Right-aligned so the % sits flush against the glyph's left
         edge. Auto-hides when no battery is reported.
         Layout: text right-edge at pos.x + size.x = 0.88 + 0.05 =
         0.93. Battery glyph at pos.x=0.94. Gap: 0.01. -->
    <text name="batteryPercent" extra="true">
      <pos>0.88 0.03</pos>
      <size>0.05 0.06</size>
      <fontPath>${fontRegular}</fontPath>
      <fontSize>0.030</fontSize>
      <color>${textPrimary}</color>
      <alignment>right</alignment>
      <text>{global:batteryLevel}%</text>
      <!-- v0.10 round-3: <visible>{global:battery}</visible> appeared to
           evaluate false on-device even with a battery present, hiding
           the element. Removed; the percentage renders unconditionally.
           The batteryIcon's built-in auto-hide handles devices without
           a battery. On a no-battery device the binding may resolve to
           a sentinel (e.g. "[None]%") — acceptable until a working
           visible-binding is found. -->
      <visible>true</visible>
    </text>

    <!-- Clock shifted left so its right edge clears the percentage's
         left edge. v0.9.3 clock pos.x=0.78 right-edge at 0.92
         collides with the new percentage's left edge at 0.88.
         Shifting to pos.x=0.72 puts the clock's right edge at 0.86 —
         0.02 gap to the percentage element. -->
    <text name="clock">
      <pos>0.72 0.03</pos>
      <size>0.14 0.06</size>
      <fontPath>${fontRegular}</fontPath>
      <fontSize>0.042</fontSize>
      <color>${textPrimary}</color>
      <alignment>right</alignment>
    </text>
  </view>
</theme>
