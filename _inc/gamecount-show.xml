<?xml version="1.0" encoding="UTF-8"?>
<!--
  es-theme-xmb-psp - "Game Count: Show".
  Shows the carousel's systemInfo slot, which displays blank briefly then
  cycles to "X GAMES" after systemInfoDelay ms. The extra systemName
  element (system.xml) is hidden so it doesn't overlap.
  Selected via UI Settings > Theme Configuration > Game Count > Show.
  CC-BY-NC-SA 2.0. See CREDITS.md.
-->
<theme>
  <formatVersion>7</formatVersion>
  <view name="system">
    <carousel name="systemcarousel">
      <systemInfoDelay>1500</systemInfoDelay>
    </carousel>
    <!-- Show the carousel's count-cycling element and hide the static
         name caption so the name->count cycle is visible. -->
    <text name="systemInfo">
      <visible>true</visible>
    </text>
    <text name="systemName" extra="true">
      <visible>false</visible>
    </text>
  </view>
</theme>
