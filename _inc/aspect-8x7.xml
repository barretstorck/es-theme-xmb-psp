<?xml version="1.0" encoding="UTF-8"?>
<!--
  es-theme-xmb-psp - 8:7 aspect-ratio overrides.
  Loaded conditionally by theme.xml when ${screen.ratio} == '8/7'.
  Overrides only the geometry variables that visually drift from
  4:3 defaults at 8:7. Design surface: 1024x896. See P1 in
  docs/superpowers/specs/2026-05-23-v0.8-multi-aspect-ratio-design.md
  for the squareness-in-pixels reasoning behind these values.
  CC-BY-NC-SA 2.0. See CREDITS.md.
-->
<theme>
  <formatVersion>7</formatVersion>
  <variables>

    <!-- Status cluster (§6.5). The battery percentage's <fontSize> is a
         fraction of screen HEIGHT while these positions are fractions of
         WIDTH, so at 1024x896 "100%" renders 0.055 of the width (0.047 at
         4:3) and the 4:3 literals would run it into the battery glyph.
         Shift the three left-hand elements; the glyph stays at 0.98. -->
    <statusClockX>0.660</statusClockX>
    <statusNetX>0.849</statusNetX>
    <statusPctX>0.865</statusPctX>
    <!-- Icon squareness (P1): screen is 1024w x 896h, so H fractions
         shrink relative to 4:3 to keep icons square in screen pixels. -->
    <sysIconMaxH>0.14</sysIconMaxH>
    <sysCarouselLogoH>0.12</sysCarouselLogoH>

    <!-- Card metadata font renormalized (P1 reasoning): 8:7 shares 4:3's
         1024px width but is taller, so the height-normalized 0.030 font
         inflates to ~27px — too large for the metadata row at this ratio.
         0.026 x 896 = 23px, matching the 4:3 pixel size exactly. -->
    <cardMetaFontSize>0.029</cardMetaFontSize>

    <!-- v0.12 gamelist styles -->
    <cardMediaW>0.40</cardMediaW>
    <cardMediaH>0.30</cardMediaH>
    <cardDescH>0.160</cardDescH>

    <!-- Added beyond the brief (found by rendering, not listed there):
         style B's listStars/listStarTrack fontSize is fixed at 0.028 (not a
         variable, gamelist-list.xml is out of scope to edit), so its pixel
         width scales with height alone. At 1024x896 that inflates the
         5-glyph track to where it lands flush against listMeta (0.700) with
         ~0px clearance (confirmed touching in the render). Shift listStarX
         left to restore a ~20px gap; listMetaX is left untouched so its
         0.27-wide box keeps the same right-edge margin as every other
         ratio. -->
    <listStarX>0.555</listStarX>
  </variables>
</theme>
