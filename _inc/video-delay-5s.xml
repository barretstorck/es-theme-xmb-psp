<?xml version="1.0" encoding="UTF-8"?>
<!--
  es-theme-xmb-psp - "Video Delay: 5 seconds" (default).
  Sets ${videoDelay}=5 so the still screenshot shows for 5 seconds before
  the preview video starts. This matches the theme's pre-v0.9.3-round-4
  default.
  Selected via UI Settings > Theme Configuration > Video Delay > 5 seconds.
  CC-BY-NC-SA 2.0. See CREDITS.md.
-->
<theme>
  <formatVersion>7</formatVersion>
  <variables>
    <videoDelay>5</videoDelay>
  </variables>
</theme>
