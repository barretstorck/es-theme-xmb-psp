<?xml version="1.0" encoding="UTF-8"?>
<!--
  es-theme-xmb-psp - 3:2 aspect-ratio overrides.
  Loaded conditionally by theme.xml when ${screen.ratio} == '3/2'.
  Design surface: 720x480. See P1-P3 in
  docs/superpowers/specs/2026-05-23-v0.8-multi-aspect-ratio-design.md.
  CC-BY-NC-SA 2.0. See CREDITS.md.
-->
<theme>
  <formatVersion>7</formatVersion>
  <variables>
    <!-- Icon squareness (P1) -->
    <sysIconMaxW>0.11</sysIconMaxW>
    <sysIconMaxH>0.17</sysIconMaxH>
    <sysCarouselLogoW>0.09</sysCarouselLogoW>

    <!-- Carousel slot spacing (constant 165 px across ratios) -->
    <sysCarouselSizeW>1.60</sysCarouselSizeW>     <!-- K=1.62 × logoW=0.09 × 11 -->
    <sysCarouselPosX>-0.56</sysCarouselPosX>      <!-- crossX - sysCarouselSizeW/2 = 0.24 - 0.80 -->

    <!-- Card metadata font, renormalized for this ratio (originally tuned
         against a combined genre+stars box that the v0.12 metadata split
         replaced with separate cardGenre/cardStarTrack/cardPlayers columns;
         value kept as-is, still comfortably clears the star-track budget
         test below). -->
    <cardMetaFontSize>0.030</cardMetaFontSize>

    <!-- v0.12 gamelist styles -->
    <cardMediaW>0.42</cardMediaW>
    <cardMediaH>0.32</cardMediaH>
    <listMediaW>0.32</listMediaW>
  </variables>
</theme>
