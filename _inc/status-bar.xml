<?xml version="1.0" encoding="UTF-8"?>
<!--
  es-theme-xmb-psp - the top-right status cluster, and ES's OSD suppression.

  The cluster is a <stackpanel>, not four absolutely-positioned elements,
  because its contents are OPTIONAL and ES decides which ones exist:
  UI Settings > Show Battery Status hides the percentage (ICON) or both
  battery elements (NO), and the network glyph disappears when there is no
  connection. Fixed positions reserve space for elements that may not be
  there, so v1.0's first attempt left a 77px hole where the percentage had
  been, and ~120px of dead space against the right margin at NO.

  StackPanelComponent::performLayout() skips invisible children, and its
  update() re-runs the layout whenever the visible children's total size
  changes - so the cluster re-packs itself the moment ES hides one.

  See docs/psp-xmb-style-guidelines.md 6.5.
  CC-BY-NC-SA 2.0. See CREDITS.md.
-->
<theme>
  <formatVersion>7</formatVersion>

  <view name="screen">
    <!-- Hide ES's built-in OSD overlays so they don't double up with our
         theme. controllerActivity is the white-pink square, bottom-left by
         default. -->
    <controllerActivity name="controllerActivity">
      <visible>false</visible>
    </controllerActivity>

    <!-- ES draws a SECOND battery widget of its own: BatteryIndicatorComponent
         (Window.cpp:157, rendered at :746), a ControllerActivityComponent
         subclass pinned top-right at 0.955/0.0125 that shows wifi + battery
         glyph + "NN%" in ES's own font. It is not the controllerActivity
         above - hiding that one leaves this one drawing. It is why v0.10
         concluded <visible>false</visible> "did not hide the icon on-device":
         the theme was hiding its own batteryIcon while ES kept painting this.
         Unlike batteryIcon (whose update() calls setVisible() every tick and
         so overwrites any themed value), this one honours <visible> - its
         render() early-returns on !isVisible() and nothing sets it back. -->
    <batteryIndicator name="batteryIndicator">
      <visible>false</visible>
    </batteryIndicator>

    <!-- ES's Window-owned clock, deliberately transparent. The real clock is
         the <clock> child of the panel below, because only a child of the
         stackpanel can move when its neighbours disappear.

         This element cannot simply be dropped: with no screen/clock element
         to theme, Window skins mClock from the helpsystem and parks it at
         0.94 / 0.9965 (Window.cpp:1274-1300) - a small grey clock in the
         BOTTOM-right corner. And it cannot be hidden with <visible>, because
         ClockComponent::update() calls setVisible(DrawClock) every frame and
         would immediately undo it. Alpha 00 is the one property nothing
         overwrites. -->
    <text name="clock">
      <pos>0.84 0.03</pos>
      <size>0.14 0.06</size>
      <fontPath>${fontRegular}</fontPath>
      <fontSize>0.042</fontSize>
      <color>FFFFFF00</color>
      <alignment>right</alignment>
    </text>

    <!-- The cluster. Children are laid out RIGHT TO LEFT (reverse), so the
         first child below is the rightmost on screen, and the panel's right
         edge - pos.x + size.x = 0.48 + 0.50 = 0.98 - is the margin the whole
         cluster hangs from.

         <stackpanel> has NO origin property (ThemeData.cpp:72), so pos is its
         TOP-LEFT corner. Setting origin here parses to nothing and puts the
         panel off the right of the screen, where it renders as absolutely
         nothing - there is no warning.

         The panel is deliberately much wider than its contents. Unused width
         extends to the LEFT and costs nothing, since reverse packing starts
         at the right edge. That is what lets one set of literals serve all
         five aspect ratios: a <fontSize> is a fraction of screen HEIGHT while
         positions are fractions of WIDTH, so the percentage is 0.058 of the
         width at 1:1 against 0.045 at 4:3, and any hand-placed layout has to
         be re-tuned per ratio to stop it colliding. A panel just packs.

         Height is 0.030 - ONE glyph ink-height, not the 0.06 of the strip -
         because performLayout() top-aligns image children whatever their
         origin: it sets y to (pos.y - h*origin.y + panelH*origin.y) and then
         the origin shifts the draw back by h*origin.y, so the h terms cancel
         and every value lands at the panel's top. With the panel exactly as
         tall as the glyphs, top-aligned IS centred. Text children are handled
         separately (see verticalAlignment below), and are free to be taller
         than the panel. pos.y = 0.0612 - 0.030/2, the measured clock ink
         centre minus half the height.

         separator is a fraction of screen HEIGHT for a horizontal panel
         (StackPanelComponent.cpp:59), not of width. -->
    <stackpanel name="statusCluster">
      <pos>0.48 0.0462</pos>
      <size>0.50 0.030</size>
      <orientation>horizontal</orientation>
      <reverse>true</reverse>
      <separator>0.020</separator>
      <clipChildren>false</clipChildren>

      <!-- Battery glyph, rightmost. ES picks the state image itself from the
           charge level (BatteryIconComponent.cpp:52-69) and calls
           setVisible(hasBattery), so a device without a battery shows nothing
           here and needs no theme setting. Note a device reporting "Full"
           while plugged in counts as CHARGING, so it shows the bolt and never
           the 3-bar full art.

           maxSize, never size: performLayout only preserves aspect for images
           whose target IS max (ImageComponent::getTargetIsMax). Give this a
           <size> instead and ES stretches the art to fill the panel height,
           which reads as a fat, squashed battery. The width here is generous
           on purpose - the fit ends up limited by the panel's height, which
           is what keeps the glyph the same 23px at every aspect ratio. -->
      <batteryIcon name="batteryStatus">
        <maxSize>0.125 1</maxSize>
        <color>${textPrimary}</color>
        <empty>./art/battery/battery-empty.png</empty>
        <at25>./art/battery/battery-25.png</at25>
        <at50>./art/battery/battery-50.png</at50>
        <at75>./art/battery/battery-75.png</at75>
        <full>./art/battery/battery-full.png</full>
        <incharge>./art/battery/battery-incharge.png</incharge>
      </batteryIcon>

      <!-- Battery percentage (audit ST1). MUST be a native <batteryText>: a
           binding-based <text extra="true">{global:batteryLevel}%</text>
           renders EMPTY here, because nothing ever resolves bindings in the
           screen view. Window.cpp:1258 builds the screen extras but no
           BindingManager::updateBindings call exists for them (only
           SystemView, the gamelist containers, Splash and the carousel/grid
           item templates do that). That is the real cause of v0.10's
           "percentage would not render", and it is unfixable from the theme -
           do not retry the binding.

           Shown only when Show Battery Status is ICON AND TEXT; at ICON this
           child hides and the panel closes the gap. -->
      <batteryText name="batteryPercent">
        <fontPath>${fontRegular}</fontPath>
        <fontSize>0.030</fontSize>
        <color>${textPrimary}</color>
      </batteryText>

      <!-- Hiding batteryIndicator above also removed ES's wifi glyph, so the
           theme draws its own. Auto-hides when disconnected -
           NetworkIconComponent::update() does
           setVisible(ShowNetworkIndicator && connected). -->
      <networkIcon name="networkStatus">
        <maxSize>0.09 1</maxSize>
        <color>${textPrimary}</color>
        <path>./art/ui/network.png</path>
      </networkIcon>

      <!-- The clock, leftmost, and a real child so it slides right when the
           battery elements go away. ClockComponent honours ES's own ClockMode12
           and DrawClock settings exactly as the Window-owned clock does, so
           turning SHOW CLOCK off collapses the cluster too.

           verticalAlignment centres the text in the box performLayout gives it
           (the panel's height), and TextComponent does not clip to that box,
           so a 0.042 font centres correctly inside a 0.030-tall panel. -->
      <clock name="statusClock">
        <fontPath>${fontRegular}</fontPath>
        <fontSize>0.042</fontSize>
        <color>${textPrimary}</color>
      </clock>
    </stackpanel>
  </view>
</theme>
