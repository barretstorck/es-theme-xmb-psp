<?xml version="1.0" encoding="UTF-8"?>
<!--
  es-theme-xmb-psp - "Title Visibility: With Titles" (Friendly).
  Unselected rows show titles centered at row center (Y=0.50) at full
  opacity; selected row's title still slides up to Y=0.25 to make room
  for the line and metadata.
  Selected via UI Settings > Theme Configuration > Title Visibility > With Titles.
  CC-BY-NC-SA 2.0. See CREDITS.md.
-->
<theme>
  <formatVersion>7</formatVersion>
  <variables>
    <titleUnselectedY>0.50</titleUnselectedY>
    <titleUnselectedOpacity>1</titleUnselectedOpacity>
  </variables>
</theme>
