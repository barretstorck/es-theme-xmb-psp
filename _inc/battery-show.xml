<?xml version="1.0" encoding="UTF-8"?>
<!--
  es-theme-xmb-psp - "Battery: Show" (default).
  This variant is a no-op against common.xml's defaults: the batteryIcon
  is visible (auto-shown by ES on devices that report a battery and have
  Show Battery Status enabled), and the clock sits at x=0.78 to leave
  room for the battery glyph to its right at x=0.94.
  Selected via UI Settings > Theme Configuration > Battery > Show.
  CC-BY-NC-SA 2.0. See CREDITS.md.
-->
<theme>
  <formatVersion>7</formatVersion>
  <view name="screen">
    <!-- Explicit positional restore so swapping variants is safe in both
         directions (Hide → Show won't carry over the Hide layout). -->
    <text name="clock">
      <pos>0.78 0.03</pos>
    </text>
    <image name="batteryIcon">
      <visible>true</visible>
    </image>
  </view>
</theme>
