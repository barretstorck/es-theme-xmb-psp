<?xml version="1.0" encoding="UTF-8"?>
<!--
  es-theme-xmb-psp - 1:1 (square) aspect-ratio overrides.
  Loaded conditionally by theme.xml when ${screen.ratio} == '1/1'.
  Design surface: 720x720 (RG Cube X). Square is the hardest case —
  the XMB cross must share narrow horizontal space with the gamelist.
  See P1-P4 in
  docs/superpowers/specs/2026-05-23-v0.8-multi-aspect-ratio-design.md.
  CC-BY-NC-SA 2.0. See CREDITS.md.
-->
<theme>
  <formatVersion>7</formatVersion>
  <variables>
    <!-- Cross anchor + balance (P2): raise center, pull left -->
    <crossX>0.22</crossX>
    <crossY>0.27</crossY>
    <captionY>0.38</captionY>
    <sysCarouselSizeW>2.32</sysCarouselSizeW>     <!-- K=1.62 × logoW=0.13 × 11 -->
    <sysCarouselPosX>-0.94</sysCarouselPosX>      <!-- crossX - sysCarouselSizeW/2 = 0.22 - 1.16 -->

    <!-- Icon squareness (P1): square screen -> equal W and H -->
    <sysIconMaxW>0.16</sysIconMaxW>
    <sysIconMaxH>0.16</sysIconMaxH>
    <sysCarouselLogoW>0.13</sysCarouselLogoW>
    <sysCarouselLogoH>0.13</sysCarouselLogoH>

    <!-- Vertical arm (P2): more room below the raised cross -->
    <gameColX>0.06</gameColX>
    <gameColTextY>0.47</gameColTextY>
    <gameColH>0.46</gameColH>

    <!-- Card metadata font, renormalized for this ratio: at 720x720 the
         height-normalized font stays ~21.6px at 4:3's 0.030, too large for
         the narrower metadata columns here. 0.023 x 720 = 16.6px keeps the
         same pixel proportion 4:3 used (225px-wide box : 23px font). -->
    <cardMetaFontSize>0.023</cardMetaFontSize>

    <!-- v0.12 gamelist styles: square screen means vertical space is the
         constraint; shrink the media envelope or it collides with the
         title. -->
    <cardMediaW>0.44</cardMediaW>
    <cardMediaH>0.26</cardMediaH>
    <cardDescH>0.150</cardDescH>
    <listMediaH>0.24</listMediaH>
    <gridTileH>0.210</gridTileH>

    <!-- Added beyond the brief (found by rendering, not listed there):
         same fixed-fontSize issue as aspect-8x7.xml, worse here because the
         720-wide screen shrinks the denominator that turns the track's
         pixel width into a variable-fraction. Render showed the star track
         and "1P"/"2P" fully overlapping (glyphs touching with no gap) at
         720x720. Shift listStarX left; kept clear of the textlist's right
         edge (0.525) with ~10px to spare. -->
    <listStarX>0.540</listStarX>
  </variables>
</theme>
