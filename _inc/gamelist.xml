<?xml version="1.0" encoding="UTF-8"?>
<!--
  es-theme-xmb-psp - gamelist views (v0.7).
  A shared <view name="detailed,gamecarousel"> block holds the wave, pinned
  system icon + caption, and the right info panel (title / rating / video /
  description). Each gamelist style then adds only its game column: the
  'detailed' view a text list, the 'gamecarousel' view a boxart carousel.
  The top-right clock is provided globally by the screen view in common.xml.
  CC-BY-NC-SA 2.0. See CREDITS.md.
-->
<theme>
  <formatVersion>7</formatVersion>

  <!-- ============================================================
       Shared by both gamelist styles: continuity + right info panel
       ============================================================ -->
  <view name="detailed,gamecarousel">

    <!-- Wave background. extra="true" required to render. -->
    <image name="waveBackground" extra="true">
      <path>./art/wave/wave.png</path>
      <pos>0.5 0.5</pos>
      <size>1.10 1.10</size>
      <origin>0.5 0.5</origin>
      <color>${waveTint}</color>
      <zIndex>0</zIndex>
    </image>

    <!-- KNULLI BUILD QUIRK: storyboard-animated extra="true" elements
         declared only inside a separate include file do not animate on the
         detailed/gamecarousel views on this Knulli ES build. The three
         waveLayer declarations below are therefore duplicated verbatim from
         _inc/wave-motion.xml so they sit directly in this view block and
         animate. If you tune any wave property (storyboard duration,
         opacity, color, size, path), update BOTH files to keep them in
         sync. Do not delete these as "redundant" - that re-breaks the
         gamelist wave animation. -->
    <!-- Wave layer 1: top crest, slowest scroll -->
    <image name="waveLayer1" extra="true">
      <path>./art/wave/wave-layer-1.png</path>
      <pos>0.0 0.5</pos>
      <size>2.00 1.10</size>
      <origin>0.0 0.5</origin>
      <color>${accent}</color>
      <opacity>0.85</opacity>
      <zIndex>1</zIndex>
      <storyboard>
        <animation property="x" from="0.0" to="-1.0"
                   duration="30000" mode="linear"
                   repeat="forever"/>
      </storyboard>
    </image>

    <!-- Wave layer 2: middle crest, medium scroll -->
    <image name="waveLayer2" extra="true">
      <path>./art/wave/wave-layer-2.png</path>
      <pos>0.0 0.5</pos>
      <size>2.00 1.10</size>
      <origin>0.0 0.5</origin>
      <color>${accent}</color>
      <opacity>0.85</opacity>
      <zIndex>2</zIndex>
      <storyboard>
        <animation property="x" from="0.0" to="-1.0"
                   duration="20000" mode="linear"
                   repeat="forever"/>
      </storyboard>
    </image>

    <!-- Wave layer 3: bottom crest, fastest scroll -->
    <image name="waveLayer3" extra="true">
      <path>./art/wave/wave-layer-3.png</path>
      <pos>0.0 0.5</pos>
      <size>2.00 1.10</size>
      <origin>0.0 0.5</origin>
      <color>${accent}</color>
      <opacity>0.85</opacity>
      <zIndex>3</zIndex>
      <storyboard>
        <animation property="x" from="0.0" to="-1.0"
                   duration="12000" mode="linear"
                   repeat="forever"/>
      </storyboard>
    </image>

    <!-- Selected system icon, pinned to the cross anchor so it lines up
         with the system view's selected carousel logo. zIndex 8 keeps the
         icon above the gamecarousel (zIndex 5): on this Knulli build
         carousel items can escape their container bounds, so the raised
         zIndex is the no-peek guard. -->
    <image name="logo">
      <path>./art/system-icons/${system.theme}.png</path>
      <pos>${crossX} ${crossY}</pos>
      <origin>0.5 0.5</origin>
      <maxSize>${glIconMaxW} ${glIconMaxH}</maxSize>
      <zIndex>8</zIndex>
    </image>

    <!-- System-name caption: short name (${system.theme}), uppercase,
         pinned under the icon. extra="true" required to render. -->
    <text name="systemName" extra="true">
      <pos>${crossX} ${captionY}</pos>
      <origin>0.5 0</origin>
      <size>0.5 0.055</size>
      <fontPath>${fontLight}</fontPath>
      <fontSize>0.034</fontSize>
      <color>${textSecondary}</color>
      <backgroundColor>00000000</backgroundColor>
      <alignment>center</alignment>
      <forceUppercase>true</forceUppercase>
      <text>${system.theme}</text>
      <zIndex>6</zIndex>
    </text>

    <!-- Right info panel: title, rating, screenshot-then-video, description. -->
    <text name="md_name">
      <pos>${panelX} 0.10</pos>
      <size>${panelW} 0.06</size>
      <fontPath>${fontBold}</fontPath>
      <fontSize>0.035</fontSize>
      <color>${textPrimary}</color>
      <alignment>center</alignment>
      <zIndex>5</zIndex>
    </text>

    <rating name="md_rating">
      <pos>${mdRatingX} 0.17</pos>
      <size>0.18 0.04</size>
      <color>${accent}</color>
      <zIndex>5</zIndex>
    </rating>

    <!-- Shows the game's snapshot still during the 5s delay and whenever
         the game has no preview video, then plays the video. -->
    <video name="md_video">
      <pos>${mdVideoX} ${mdVideoY}</pos>
      <size>${mdVideoW} ${mdVideoH}</size>
      <origin>0.5 0.5</origin>
      <delay>5</delay>
      <showSnapshotNoVideo>true</showSnapshotNoVideo>
      <showSnapshotDelay>true</showSnapshotDelay>
      <zIndex>5</zIndex>
    </video>

    <!-- Scrolling description text. -->
    <text name="md_description">
      <pos>${panelX} ${panelDescY}</pos>
      <size>${panelW} ${panelDescH}</size>
      <fontPath>${fontLight}</fontPath>
      <fontSize>0.028</fontSize>
      <color>${textSecondary}</color>
      <container>true</container>
      <zIndex>5</zIndex>
    </text>

  </view>

  <!-- ============================================================
       'detailed' style: text-list game column
       ============================================================ -->
  <view name="detailed">
    <!-- Game list - the vertical arm of the cross, centered under the
         system icon (box centered on crossX, center-aligned text). -->
    <textlist name="gamelist">
      <pos>${gameColX} ${gameColTextY}</pos>
      <size>${gameColW} ${gameColH}</size>
      <fontPath>${fontRegular}</fontPath>
      <fontSize>0.032</fontSize>
      <horizontalMargin>0.01</horizontalMargin>
      <alignment>center</alignment>
      <primaryColor>${textSecondary}</primaryColor>
      <secondaryColor>${textSecondary}</secondaryColor>
      <selectorColor>${selectorGlow}</selectorColor>
      <selectedColor>${textPrimary}</selectedColor>
      <lineSpacing>1.4</lineSpacing>
      <zIndex>5</zIndex>
    </textlist>
  </view>

  <!-- ============================================================
       'gamecarousel' style: boxart carousel game column
       ============================================================ -->
  <view name="gamecarousel">
    <!-- Boxart game column: a vertical carousel centered under the system
         icon at crossX, the vertical arm of the XMB cross.
         KNULLI BUILD QUIRKS:
           - logoSize is CONTAINER-relative, not screen-relative.
             0.35x0.37 of this 0.32x0.42 container -> ~0.112x0.155 screen
             fraction; xlogoScale 1.35 -> ~0.15x0.21, matching the system
             icon's maxSize.
           - Carousel items do NOT clip to the container bounds, so the
             carousel is positioned entirely below the icon+caption
             (mechanism 2): top y=0.486 clears the caption bottom (~0.456),
             which is what keeps any game image from peeking behind the
             system icon.
         pos, size, logoSize, logoScale, maxLogoCount all tuned on-device. -->
    <gamecarousel name="gamecarousel">
      <type>vertical</type>
      <imageSource>thumbnail</imageSource>
      <pos>${gameColX} ${gameColCarY}</pos>
      <size>${gameColW} ${gameColH}</size>
      <origin>0 0</origin>
      <color>00000000</color>
      <logoSize>${gameCarLogoW} ${gameCarLogoH}</logoSize>
      <logoScale>${gameCarLogoScale}</logoScale>
      <logoAlignment>center</logoAlignment>
      <!-- v0.9.3 round 4: maxLogoCount=3 restored (multi-visible XMB
           layout). ES centers selected; minLogoOpacity=0.3 makes
           unselected items significantly dimmer so the selected
           dominates. Combined with logoScale=1.5 and the halo
           element below, the selected boxart is unmistakably the
           focal point. -->
      <maxLogoCount>3</maxLogoCount>
      <minLogoOpacity>0.3</minLogoOpacity>
      <zIndex>5</zIndex>

      <!-- v0.11 PR D: per-slot itemTemplate. ES renders this once per
           game in the carousel. Boxart paints when {game:thumbnail}
           resolves; tplFallback paints the system-media glyph
           (mediaFallbackPath, set by _inc/media-fallback/<sys>.xml)
           when the thumbnail path is empty. tplLabel paints the game
           name beside every slot, selected and unselected alike (PSP
           XMB behaviour). #13 #14 #15. -->
      <itemTemplate>
        <!-- Boxart slot: scraped thumbnail when present. -->
        <image name="tplBoxart">
          <pos>0.0 0.0</pos>
          <size>${gameCarLogoW} ${gameCarLogoH}</size>
          <origin>0 0.5</origin>
          <path>{game:thumbnail}</path>
        </image>

        <!-- System-media fallback when no thumbnail. mediaFallbackPath
             is resolved per-system at theme load via the
             _inc/media-fallback/ include files (Task 4 Path B: nested
             variable indirection failed the Task 2 spike). -->
        <image name="tplFallback">
          <pos>0.0 0.0</pos>
          <size>${gameCarLogoW} ${gameCarLogoH}</size>
          <origin>0 0.5</origin>
          <path>${mediaFallbackPath}</path>
          <visible>!exists({game:thumbnail})</visible>
        </image>

        <!-- Per-logo title. Selected and unselected alike (PSP behaviour). -->
        <text name="tplLabel">
          <pos>0.45 0.0</pos>
          <size>0.55 0.4</size>
          <origin>0 0.5</origin>
          <fontPath>${fontLight}</fontPath>
          <fontSize>0.030</fontSize>
          <color>${textPrimary}</color>
          <text>{game:name}</text>
          <alignment>left</alignment>
          <verticalAlignment>center</verticalAlignment>
        </text>
      </itemTemplate>
    </gamecarousel>
  </view>

</theme>
