<?xml version="1.0" encoding="UTF-8"?>
<!--
  v0.11 gamelist redesign (v6 layout): PSP-card, selected-dominates format.

  PATH B (pinned card + extras). The overflow spike (.dev/v6-spike-overflow.png)
  proved an itemTemplate child CAN overflow its slot, so Path A's mechanism
  works. BUT the textlist cannot pin the cursor to the middle slot:
  TextListComponent's updateCameraOffset() centers the cursor only for INTERIOR
  rows and clamps to 0 at the list start, so the default landing (cursor on the
  first game) renders the selected row at the TOP slot, never centered. This
  Knulli ES build does NOT consume the <centerSelection> theme property in
  TextListComponent (only ImageGridComponent does — verified in source). So a
  pure-itemTemplate Path A can't deliver the mockup's centered card.

  Path B decouples the dominant card from the cursor slot. The big card
  (boxart, title, line, metadata, scrolling description, video) is rendered as
  extra="true" elements at a FIXED screen anchor (crossX, cardY=0.59) binding
  {game:*}. ES's ISimpleGameListView::updateThemeExtrasBindings() rebinds those
  placeholders to the SELECTED game on every cursor change (proven in
  .dev/v6-spike-pathb.png — the extras showed Contra's boxart/name while the
  textlist still listed all rows). The textlist itself only renders the small
  PEEK icons (and, in Friendly mode, small dim titles). The selected row's own
  peek icon is hidden on activate so it doesn't double up with the big card.

  Spike outcomes (see .dev/spike-results.txt + .dev/v6-spike-*.png):
   - itemTemplate child larger than its slot overflows (not clipped to slot).
   - extra="true" elements binding {game:thumbnail}/{game:name}/{game:desc}
     rebind to the selected game on cursor change.
   - property="position" does NOT animate; property="x"/"y" DO.
   - Variable substitution in storyboard from/to WORKS.

  See docs/superpowers/specs/2026-05-27-v0.11-gamelist-redesign-design.md.
  CC-BY-NC-SA 2.0. See CREDITS.md.
-->
<theme>
  <formatVersion>7</formatVersion>

  <view name="detailed,gamecarousel">

    <!-- Wave background. extra="true" required to render. -->
    <image name="waveBackground" extra="true">
      <path>./art/wave/wave.png</path>
      <pos>0.5 0.5</pos>
      <size>1.10 1.10</size>
      <origin>0.5 0.5</origin>
      <color>${waveTint}</color>
      <zIndex>0</zIndex>
    </image>

    <!-- KNULLI BUILD QUIRK: storyboard-animated extra="true" elements
         declared only inside _inc/wave-motion.xml do not animate on
         gamelist views on this Knulli ES build. The three waveLayer
         declarations below are duplicated verbatim from
         _inc/wave-motion.xml so they sit directly in the view block. -->
    <image name="waveLayer1" extra="true">
      <path>./art/wave/wave-layer-1.png</path>
      <pos>0.0 0.5</pos>
      <size>2.00 1.10</size>
      <origin>0.0 0.5</origin>
      <color>${accent}</color>
      <opacity>0.85</opacity>
      <zIndex>1</zIndex>
      <storyboard>
        <animation property="x" from="0.0" to="-1.0"
                   duration="30000" mode="linear"
                   repeat="forever"/>
      </storyboard>
    </image>
    <image name="waveLayer2" extra="true">
      <path>./art/wave/wave-layer-2.png</path>
      <pos>0.0 0.5</pos>
      <size>2.00 1.10</size>
      <origin>0.0 0.5</origin>
      <color>${accent}</color>
      <opacity>0.85</opacity>
      <zIndex>2</zIndex>
      <storyboard>
        <animation property="x" from="0.0" to="-1.0"
                   duration="20000" mode="linear"
                   repeat="forever"/>
      </storyboard>
    </image>
    <image name="waveLayer3" extra="true">
      <path>./art/wave/wave-layer-3.png</path>
      <pos>0.0 0.5</pos>
      <size>2.00 1.10</size>
      <origin>0.0 0.5</origin>
      <color>${accent}</color>
      <opacity>0.85</opacity>
      <zIndex>3</zIndex>
      <storyboard>
        <animation property="x" from="0.0" to="-1.0"
                   duration="12000" mode="linear"
                   repeat="forever"/>
      </storyboard>
    </image>

    <!-- Pinned system icon. v0.11 v6 (PR #32 redesign): moved UP to
         (crossX, glLogoY=0.14) per the approved v6 mockup so the header sits
         above the card list. Sized to the SELECTED system-carousel icon
         (sysIconMaxW/H * logoScale=1.5 = 0.18 x 0.24) so it still visually
         matches the system->gamelist transition anchor. -->
    <image name="logo">
      <path>./art/system-icons/${system.theme}.png</path>
      <pos>${crossX} ${glLogoY}</pos>
      <maxSize>0.18 0.24</maxSize>
      <origin>0.5 0.5</origin>
      <zIndex>6</zIndex>
    </image>

    <!-- System-name caption, tight below the pinned icon (v6: glCaptionY). -->
    <text name="md_systemName" extra="true">
      <pos>${crossX} ${glCaptionY}</pos>
      <origin>0.5 0</origin>
      <size>0.5 0.06</size>
      <fontPath>${fontLight}</fontPath>
      <fontSize>0.040</fontSize>
      <color>${textSecondary}</color>
      <text>${system.theme}</text>
      <alignment>center</alignment>
      <forceUppercase>true</forceUppercase>
      <zIndex>6</zIndex>
    </text>

    <!-- ============================================================
         BIG SELECTED CARD (Path B fixed-position extras).
         All bind {game:*}; ES rebinds them to the selected game on
         cursor change. Anchored at the textlist's MIDDLE slot
         (crossX, cardY) so when the cursor is centered the card sits
         over the middle peek; when the cursor is at the list edge the
         card still floats at cardY as the dominant element.
         ============================================================ -->

    <!-- Selected boxart, 240px (Boxart) / 165px (Compact), bisected by the
         line at cardY. maxSize preserves aspect for non-square scraped art. -->
    <image name="cardBoxart" extra="true">
      <path>{game:thumbnail}</path>
      <pos>${crossX} ${cardY}</pos>
      <maxSize>${cardBoxartW} ${cardBoxartH}</maxSize>
      <origin>0.5 0.5</origin>
      <zIndex>8</zIndex>
    </image>

    <!-- Media fallback when the selected game has no thumbnail. -->
    <image name="cardFallback" extra="true">
      <path>${mediaFallbackPath}</path>
      <pos>${crossX} ${cardY}</pos>
      <maxSize>${cardBoxartW} ${cardBoxartH}</maxSize>
      <origin>0.5 0.5</origin>
      <visible>!exists({game:thumbnail})</visible>
      <zIndex>8</zIndex>
    </image>

    <!-- Inline video preview for the selected game. Single element tracking
         selection via {game:video} rebinding (v6: kept as a single extra so
         only ONE video plays at a time — does not regress the round-4
         single-video-tracking behaviour). Audio-leak-on-hidden remains a
         known on-device issue; not regressed here. -->
    <video name="cardVideo" extra="true">
      <path>{game:video}</path>
      <pos>${crossX} ${cardY}</pos>
      <size>${cardBoxartW} ${cardBoxartH}</size>
      <origin>0.5 0.5</origin>
      <delay>${videoDelay}</delay>
      <showSnapshotNoVideo>false</showSnapshotNoVideo>
      <visible>exists({game:video})</visible>
      <zIndex>9</zIndex>
    </video>

    <!-- Big title, right of the boxart, sitting just above the line. -->
    <text name="cardTitle" extra="true">
      <pos>${cardTextX} ${cardTitleY}</pos>
      <size>${cardTextW} 0.16</size>
      <origin>0 1</origin>
      <fontPath>${fontRegular}</fontPath>
      <fontSize>${cardTitleFontSize}</fontSize>
      <color>${textPrimary}</color>
      <text>{game:name}</text>
      <alignment>left</alignment>
      <verticalAlignment>bottom</verticalAlignment>
      <zIndex>8</zIndex>
    </text>

    <!-- Horizontal line, bisecting the boxart vertically at cardY. -->
    <image name="cardLine" extra="true">
      <path>./art/line-1px.png</path>
      <pos>${cardTextX} ${cardY}</pos>
      <size>${cardLineW} ${cardLineH}</size>
      <origin>0 0.5</origin>
      <color>${textPrimary}</color>
      <zIndex>8</zIndex>
    </image>

    <!-- Metadata below the line, LEFT: genre + stars. {game:lastplayed}
         intentionally omitted (epoch leak on this build). -->
    <text name="cardMetadata" extra="true">
      <pos>${cardTextX} ${cardMetaY}</pos>
      <size>0.22 0.10</size>
      <origin>0 0</origin>
      <fontPath>${fontLight}</fontPath>
      <fontSize>${cardMetaFontSize}</fontSize>
      <color>${textSecondary}</color>
      <text>{game:genre} · {game:stars}</text>
      <alignment>left</alignment>
      <verticalAlignment>top</verticalAlignment>
      <zIndex>8</zIndex>
    </text>

    <!-- Scrolling description, RIGHT of the metadata, under the line.
         <autoScrollSpeed> drives the marquee (NOT <container> on this build);
         tunable via the Scroll Speed subset. -->
    <text name="cardDesc" extra="true">
      <pos>${cardDescX} ${cardMetaY}</pos>
      <size>${cardDescW} 0.10</size>
      <origin>0 0</origin>
      <fontPath>${fontLight}</fontPath>
      <fontSize>${cardMetaFontSize}</fontSize>
      <color>${textSecondary}</color>
      <text>{game:desc}</text>
      <alignment>left</alignment>
      <verticalAlignment>top</verticalAlignment>
      <autoScrollSpeed>200</autoScrollSpeed>
      <zIndex>8</zIndex>
    </text>

    <!-- Suppress ES's built-in metadata elements (md_*). The card above
         replaces the default right info panel, so the default rendering of
         md_name / md_rating / md_video / md_image / md_description would
         otherwise paint in unstyled locations. -->
    <text name="md_name"><visible>false</visible></text>
    <text name="md_description"><visible>false</visible></text>
    <text name="md_developer"><visible>false</visible></text>
    <text name="md_publisher"><visible>false</visible></text>
    <text name="md_genre"><visible>false</visible></text>
    <text name="md_players"><visible>false</visible></text>
    <text name="md_lbl_rating"><visible>false</visible></text>
    <text name="md_lbl_releasedate"><visible>false</visible></text>
    <text name="md_lbl_developer"><visible>false</visible></text>
    <text name="md_lbl_publisher"><visible>false</visible></text>
    <text name="md_lbl_genre"><visible>false</visible></text>
    <text name="md_lbl_players"><visible>false</visible></text>
    <text name="md_lbl_lastplayed"><visible>false</visible></text>
    <text name="md_lbl_playcount"><visible>false</visible></text>
    <text name="md_releasedate"><visible>false</visible></text>
    <text name="md_lastplayed"><visible>false</visible></text>
    <text name="md_playcount"><visible>false</visible></text>
    <datetime name="md_releasedate"><visible>false</visible></datetime>
    <datetime name="md_lastplayed"><visible>false</visible></datetime>
    <rating name="md_rating"><visible>false</visible></rating>
    <image name="md_image"><visible>false</visible></image>
    <image name="md_thumbnail"><visible>false</visible></image>
    <image name="md_marquee"><visible>false</visible></image>
    <video name="md_video"><visible>false</visible></video>

    <!-- ============================================================
         PEEK LIST. The textlist provides only the small prev/next peek
         icons (Boxart) plus a small dim title (Friendly). 3 slots whose
         centers land at glRowY top/mid/bottom (0.37 / 0.59 / 0.81). The
         middle slot sits under the big card; the selected row's own peek
         icon/title fade out on activate so they don't double up with the
         card.
         ============================================================ -->
    <textlist name="gamelist">
      <pos>0.0 ${glListTop}</pos>
      <size>1.0 ${glListH}</size>
      <!-- <lines>3</lines> allocates three equal vertical slots inside
           <size>; without it ES collapses slots to ~0px when fontSize is
           tiny (set tiny below to suppress default text). See
           TextListComponent.h:611. -->
      <lines>3</lines>
      <lineSpacing>1.0</lineSpacing>
      <fontSize>0.0001</fontSize>
      <primaryColor>00000000</primaryColor>
      <secondaryColor>00000000</secondaryColor>
      <selectedColor>00000000</selectedColor>
      <selectorColor>00000000</selectorColor>
      <selectorImagePath></selectorImagePath>
      <zIndex>5</zIndex>

      <itemTemplate>

        <!-- Peek boxart (65px Boxart / 46px Compact). Opacity 1 by default;
             on the selected row it fades to 0 so the big card replaces it. -->
        <image name="tplPeekIcon">
          <path>{game:thumbnail}</path>
          <pos>${crossX} 0.5</pos>
          <maxSize>${peekIconW} ${peekIconH}</maxSize>
          <origin>0.5 0.5</origin>
          <zIndex>2</zIndex>
          <opacity>1</opacity>
          <storyboard event="activate">
            <animation property="opacity" from="1" to="0" duration="150" mode="linear"/>
          </storyboard>
          <storyboard event="deactivate">
            <animation property="opacity" from="0" to="1" duration="150" mode="linear"/>
          </storyboard>
        </image>

        <!-- Peek media fallback when no thumbnail. Same activate fade. -->
        <image name="tplPeekFallback">
          <path>${mediaFallbackPath}</path>
          <pos>${crossX} 0.5</pos>
          <maxSize>${peekIconW} ${peekIconH}</maxSize>
          <origin>0.5 0.5</origin>
          <visible>!exists({game:thumbnail})</visible>
          <zIndex>2</zIndex>
          <opacity>1</opacity>
          <storyboard event="activate">
            <animation property="opacity" from="1" to="0" duration="150" mode="linear"/>
          </storyboard>
          <storyboard event="deactivate">
            <animation property="opacity" from="0" to="1" duration="150" mode="linear"/>
          </storyboard>
        </image>

        <!-- Peek title (Friendly only). titleUnselectedOpacity is 1 in the
             Friendly subset, 0 in Strict (icon-only). Hidden on the selected
             row (the big card title takes over). -->
        <text name="tplPeekTitle">
          <pos>${peekTextX} 0.5</pos>
          <size>0.70 0.30</size>
          <origin>0 0.5</origin>
          <fontPath>${fontLight}</fontPath>
          <fontSize>${peekTitleFontSize}</fontSize>
          <color>${textSecondary}</color>
          <text>{game:name}</text>
          <alignment>left</alignment>
          <verticalAlignment>center</verticalAlignment>
          <opacity>${titleUnselectedOpacity}</opacity>
          <storyboard event="activate">
            <animation property="opacity" from="${titleUnselectedOpacity}" to="0" duration="150" mode="linear"/>
          </storyboard>
          <storyboard event="deactivate">
            <animation property="opacity" from="0" to="${titleUnselectedOpacity}" duration="150" mode="linear"/>
          </storyboard>
        </text>

      </itemTemplate>
    </textlist>

  </view>
</theme>
