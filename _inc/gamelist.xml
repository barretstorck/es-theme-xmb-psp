<?xml version="1.0" encoding="UTF-8"?>
<!--
  v0.11 gamelist redesign: PSP-card row format.

  Single textlist with itemTemplate. Each row collapses to icon only
  (Strict mode) or icon + title centered (Friendly mode); the selected
  row expands with a horizontal line bisecting the icon vertically,
  title sliding up above the line, metadata fading in below.

  Spike outcomes (see .dev/spike-results.txt during development):
   - property="position" does NOT animate; property="x" / "y" DO.
     The title's only animated axis between subset states is Y, so a
     single property="y" animation is sufficient (no x movement
     between Strict and Friendly).
   - Variable substitution in storyboard from/to WORKS.
   - itemTemplate iterates per game; activate/deactivate events fire
     on the selected/previously-selected row.
   - Subset schema in this build is <subset name="..."> not
     <feature supportedFeatures="...">.

  See docs/superpowers/specs/2026-05-27-v0.11-gamelist-redesign-design.md.
  CC-BY-NC-SA 2.0. See CREDITS.md.
-->
<theme>
  <formatVersion>7</formatVersion>

  <view name="detailed,gamecarousel">

    <!-- Wave background. extra="true" required to render. -->
    <image name="waveBackground" extra="true">
      <path>./art/wave/wave.png</path>
      <pos>0.5 0.5</pos>
      <size>1.10 1.10</size>
      <origin>0.5 0.5</origin>
      <color>${waveTint}</color>
      <zIndex>0</zIndex>
    </image>

    <!-- KNULLI BUILD QUIRK: storyboard-animated extra="true" elements
         declared only inside _inc/wave-motion.xml do not animate on
         gamelist views on this Knulli ES build. The three waveLayer
         declarations below are duplicated verbatim from
         _inc/wave-motion.xml so they sit directly in the view block. -->
    <image name="waveLayer1" extra="true">
      <path>./art/wave/wave-layer-1.png</path>
      <pos>0.0 0.5</pos>
      <size>2.00 1.10</size>
      <origin>0.0 0.5</origin>
      <color>${accent}</color>
      <opacity>0.85</opacity>
      <zIndex>1</zIndex>
      <storyboard>
        <animation property="x" from="0.0" to="-1.0"
                   duration="30000" mode="linear"
                   repeat="forever"/>
      </storyboard>
    </image>
    <image name="waveLayer2" extra="true">
      <path>./art/wave/wave-layer-2.png</path>
      <pos>0.0 0.5</pos>
      <size>2.00 1.10</size>
      <origin>0.0 0.5</origin>
      <color>${accent}</color>
      <opacity>0.85</opacity>
      <zIndex>2</zIndex>
      <storyboard>
        <animation property="x" from="0.0" to="-1.0"
                   duration="20000" mode="linear"
                   repeat="forever"/>
      </storyboard>
    </image>
    <image name="waveLayer3" extra="true">
      <path>./art/wave/wave-layer-3.png</path>
      <pos>0.0 0.5</pos>
      <size>2.00 1.10</size>
      <origin>0.0 0.5</origin>
      <color>${accent}</color>
      <opacity>0.85</opacity>
      <zIndex>3</zIndex>
      <storyboard>
        <animation property="x" from="0.0" to="-1.0"
                   duration="12000" mode="linear"
                   repeat="forever"/>
      </storyboard>
    </image>

    <!-- Pinned system icon. v0.11 round 3 (bug 14): positioned at the same
         (crossX, crossY) where the selected icon sits in the system view's
         carousel, so navigating from system view to gamelist view keeps the
         icon at the same screen anchor.
         v0.11 round 4 (bug 20): sized to match the SELECTED system-carousel
         icon, which is sysIconMaxW/H scaled by logoScale=1.5 in system.xml.
         Hardcoded to 0.18 x 0.24 (0.12 * 1.5, 0.16 * 1.5) so the icon visually
         matches across the system->gamelist transition. -->
    <image name="logo">
      <path>./art/system-icons/${system.theme}.png</path>
      <pos>${crossX} ${crossY}</pos>
      <maxSize>0.18 0.24</maxSize>
      <origin>0.5 0.5</origin>
      <zIndex>6</zIndex>
    </image>

    <!-- System-name caption under the pinned icon. Aligned to captionY (0.401)
         matching the v0.10 system view's caption position (bug 14). -->
    <text name="md_systemName" extra="true">
      <pos>${crossX} ${captionY}</pos>
      <origin>0.5 0</origin>
      <size>0.5 0.06</size>
      <fontPath>${fontLight}</fontPath>
      <fontSize>0.040</fontSize>
      <color>${textSecondary}</color>
      <text>${system.theme}</text>
      <alignment>center</alignment>
      <forceUppercase>true</forceUppercase>
      <zIndex>6</zIndex>
    </text>

    <!-- Suppress ES's built-in metadata elements (md_*). The right info
         panel is replaced by per-row metadata inside the itemTemplate, so
         the default rendering of md_name / md_rating / md_video / md_image /
         md_description would otherwise paint in unstyled locations. -->
    <text name="md_name"><visible>false</visible></text>
    <text name="md_description"><visible>false</visible></text>
    <text name="md_developer"><visible>false</visible></text>
    <text name="md_publisher"><visible>false</visible></text>
    <text name="md_genre"><visible>false</visible></text>
    <text name="md_players"><visible>false</visible></text>
    <text name="md_lbl_rating"><visible>false</visible></text>
    <text name="md_lbl_releasedate"><visible>false</visible></text>
    <text name="md_lbl_developer"><visible>false</visible></text>
    <text name="md_lbl_publisher"><visible>false</visible></text>
    <text name="md_lbl_genre"><visible>false</visible></text>
    <text name="md_lbl_players"><visible>false</visible></text>
    <text name="md_lbl_lastplayed"><visible>false</visible></text>
    <text name="md_lbl_playcount"><visible>false</visible></text>
    <text name="md_releasedate"><visible>false</visible></text>
    <text name="md_lastplayed"><visible>false</visible></text>
    <text name="md_playcount"><visible>false</visible></text>
    <datetime name="md_releasedate"><visible>false</visible></datetime>
    <datetime name="md_lastplayed"><visible>false</visible></datetime>
    <rating name="md_rating"><visible>false</visible></rating>
    <image name="md_image"><visible>false</visible></image>
    <image name="md_thumbnail"><visible>false</visible></image>
    <image name="md_marquee"><visible>false</visible></image>
    <video name="md_video"><visible>false</visible></video>

    <!-- Main card list. -->
    <textlist name="gamelist">
      <pos>0.0 0.45</pos>
      <size>1.0 0.50</size>
      <!-- <lines>3</lines> forces the textlist to allocate three equal
           vertical slots inside <size>, so each slot is ~0.167 tall.
           Without this, ES sizes slots based on <fontSize>, which (when
           set tiny to suppress default text rendering) collapses every
           slot to ~0px, causing the per-row icons/lines to render as
           overlapping thin stripes. See TextListComponent.h:611. -->
      <lines>3</lines>
      <lineSpacing>1.0</lineSpacing>
      <!-- Suppress the textlist's own default text rendering (game names
           at tiny default fontSize, cycling primary/selected/secondary
           colors). itemTemplate replaces that with our card layout. The
           fontSize value no longer drives row height because <lines>3</lines>
           overrides it. -->
      <fontSize>0.0001</fontSize>
      <primaryColor>00000000</primaryColor>
      <secondaryColor>00000000</secondaryColor>
      <selectedColor>00000000</selectedColor>
      <selectorColor>00000000</selectorColor>
      <selectorImagePath></selectorImagePath>
      <zIndex>5</zIndex>

      <itemTemplate>

        <!-- 1. Halo behind selected icon. DISABLED in PR #32 visual round 3
             pending tuning (Bug 10): the white glow read too bright against
             the wave background, especially in Compact-Strict where the
             smaller boxart leaves the halo edges visible.
             TODO: re-enable after PR #32 visual tuning. -->
        <!--
        <image name="tplHalo">
          <path>./art/halo.png</path>
          <pos>${rowIconCenterX} 0.5</pos>
          <origin>0.5 0.5</origin>
          <maxSize>${rowHaloW} ${rowHaloH}</maxSize>
          <color>FFFFFF</color>
          <opacity>0</opacity>
          <zIndex>0</zIndex>
          <storyboard event="activate">
            <animation property="opacity" from="0" to="0.6" duration="150" mode="linear"/>
          </storyboard>
          <storyboard event="deactivate">
            <animation property="opacity" from="0.6" to="0" duration="150" mode="linear"/>
          </storyboard>
        </image>
        -->


        <!-- 2a. Scraped boxart, if present. <maxSize> preserves aspect
             ratio (boxart isn't 1:1, e.g. PSP UMD jewel cases are tall),
             where <size> would force-stretch arbitrary scraped images. -->
        <image name="tplIcon">
          <path>{game:thumbnail}</path>
          <pos>${rowIconX} 0.5</pos>
          <maxSize>${rowIconW} ${rowIconH}</maxSize>
          <origin>0 0.5</origin>
          <zIndex>2</zIndex>
        </image>

        <!-- 2b. Media-fallback when no thumbnail. mediaFallbackPath comes from
             _inc/media-fallback/<system>.xml (loaded conditionally by theme.xml).
             <maxSize> for the same aspect-preserving reason as tplIcon. -->
        <image name="tplFallbackIcon">
          <path>${mediaFallbackPath}</path>
          <pos>${rowIconX} 0.5</pos>
          <maxSize>${rowIconW} ${rowIconH}</maxSize>
          <origin>0 0.5</origin>
          <visible>!exists({game:thumbnail})</visible>
          <zIndex>2</zIndex>
        </image>

        <!-- 3. Inline video preview. v0.11 round 4 (bug 18): MOVED BACK inside
             itemTemplate. The round-3 extraction placed the video at a fixed
             screen Y (0.533 = first visible slot center) which painted the
             video on the TOP-MOST row regardless of cursor position. With the
             video back inside the template, ES anchors it to the current
             slot.
             Visibility is driven by opacity (0 default; activate/deactivate
             storyboards fade in/out), so playback is gated by ES's per-row
             {game:video} resolution rather than the visible-flag pathway. If
             on-device testing reveals audio leakage from opacity-0 videos,
             revisit this in a future round. -->
        <video name="tplVideo">
          <path>{game:video}</path>
          <pos>${rowIconX} 0.5</pos>
          <size>${rowIconW} ${rowIconH}</size>
          <origin>0 0.5</origin>
          <delay>${videoDelay}</delay>
          <showSnapshotNoVideo>false</showSnapshotNoVideo>
          <visible>exists({game:video})</visible>
          <opacity>0</opacity>
          <zIndex>3</zIndex>
          <storyboard event="activate">
            <animation property="opacity" from="0" to="1" duration="150" mode="linear"/>
          </storyboard>
          <storyboard event="deactivate">
            <animation property="opacity" from="1" to="0" duration="150" mode="linear"/>
          </storyboard>
        </video>

        <!-- 4. Title. Y position and opacity animate per subset; title's selected
             Y is constant 0.38 so the title's bottom edge sits just above the
             horizontal line at slot Y=0.5. Only y is animated since
             property="position" is not supported on this Knulli build. -->
        <text name="tplTitle">
          <pos>${rowTextX} ${titleUnselectedY}</pos>
          <size>0.76 0.30</size>
          <origin>0 0.5</origin>
          <fontPath>${fontRegular}</fontPath>
          <fontSize>${titleFontSize}</fontSize>
          <color>${textPrimary}</color>
          <text>{game:name}</text>
          <alignment>left</alignment>
          <verticalAlignment>center</verticalAlignment>
          <opacity>${titleUnselectedOpacity}</opacity>
          <storyboard event="activate">
            <animation property="y"
              from="${titleUnselectedY}"
              to="0.38"
              duration="150" mode="linear"/>
            <animation property="opacity"
              from="${titleUnselectedOpacity}"
              to="1"
              duration="150" mode="linear"/>
          </storyboard>
          <storyboard event="deactivate">
            <animation property="y"
              from="0.38"
              to="${titleUnselectedY}"
              duration="150" mode="linear"/>
            <animation property="opacity"
              from="1"
              to="${titleUnselectedOpacity}"
              duration="150" mode="linear"/>
          </storyboard>
        </text>

        <!-- 5. Horizontal line. Opacity 0 default; fades in only on selected row. -->
        <image name="tplLine">
          <path>./art/line-1px.png</path>
          <pos>${rowTextX} 0.5</pos>
          <size>0.76 ${rowLineH}</size>
          <origin>0 0.5</origin>
          <color>${textPrimary}</color>
          <opacity>0</opacity>
          <storyboard event="activate">
            <animation property="opacity" from="0" to="1" duration="150" mode="linear"/>
          </storyboard>
          <storyboard event="deactivate">
            <animation property="opacity" from="1" to="0" duration="150" mode="linear"/>
          </storyboard>
        </image>

        <!-- 6. Metadata below the line, LEFT half of the row.
             v0.11 round 3 (bug 17): metadata shrunk from 0.76 wide to 0.30 so
             a description marquee can occupy the right portion of the row. -->
        <text name="tplMetadata">
          <pos>${rowTextX} 0.62</pos>
          <size>0.30 0.30</size>
          <origin>0 0.5</origin>
          <fontPath>${fontLight}</fontPath>
          <fontSize>${metaFontSize}</fontSize>
          <color>${textSecondary}</color>
          <!-- {game:stars} returns Unicode RATINGSTAR (U+F005) glyphs in
               proportion to the rating (0..5). Cleaner than {game:rating}
               which would render as a raw float "0.850000".
               {game:lastplayed} is intentionally omitted: the MD_TIME
               binding returns "01/01/70" (Unix epoch formatted) for
               never-played games on this build, so shipping it leaks
               that placeholder into every fresh library. -->
          <text>{game:genre} · {game:stars}</text>
          <alignment>left</alignment>
          <verticalAlignment>center</verticalAlignment>
          <opacity>0</opacity>
          <storyboard event="activate">
            <animation property="opacity" from="0" to="1" duration="150" mode="linear"/>
          </storyboard>
          <storyboard event="deactivate">
            <animation property="opacity" from="1" to="0" duration="150" mode="linear"/>
          </storyboard>
        </text>

        <!-- 7. Scrolling description on the RIGHT of the row, under the line.
             v0.11 round 3 (bug 17): occupies the space between rowDescX and
             rowDescX+rowDescW.
             v0.11 round 4 (bug 21): <container>true</container> didn't enable
             marquee on this Knulli build. The actual mechanism is
             <autoScrollSpeed> (used by v0.10's md_description). Default 200;
             tunable via the Scroll Speed subset (_inc/scroll-speed-*.xml). -->
        <text name="tplDesc">
          <pos>${rowDescX} 0.62</pos>
          <size>${rowDescW} 0.30</size>
          <origin>0 0.5</origin>
          <fontPath>${fontLight}</fontPath>
          <fontSize>${metaFontSize}</fontSize>
          <color>${textSecondary}</color>
          <text>{game:desc}</text>
          <alignment>left</alignment>
          <verticalAlignment>center</verticalAlignment>
          <autoScrollSpeed>200</autoScrollSpeed>
          <opacity>0</opacity>
          <storyboard event="activate">
            <animation property="opacity" from="0" to="1" duration="150" mode="linear"/>
          </storyboard>
          <storyboard event="deactivate">
            <animation property="opacity" from="1" to="0" duration="150" mode="linear"/>
          </storyboard>
        </text>

      </itemTemplate>
    </textlist>

  </view>
</theme>
