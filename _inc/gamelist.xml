<?xml version="1.0" encoding="UTF-8"?>
<!--
  es-theme-xmb-psp - detailed view (gamelist), v0.5 XMB cross layout.
  The selected system icon + name caption are pinned to the shared cross
  anchor (crossX/crossY) so they line up with the system view; the game
  list unfurls down the crossX column and a preview panel fills the right.
  CC-BY-NC-SA 2.0. See CREDITS.md.
-->
<theme>
  <formatVersion>7</formatVersion>

  <view name="detailed">

    <!-- Wave background. extra="true" required to render. -->
    <image name="waveBackground" extra="true">
      <path>./art/wave/wave.png</path>
      <pos>0.5 0.5</pos>
      <size>1.10 1.10</size>
      <origin>0.5 0.5</origin>
      <color>${waveTint}</color>
      <zIndex>0</zIndex>
    </image>

    <!-- Top-right clock -->
    <datetime name="clock" extra="true">
      <pos>0.88 0.03</pos>
      <size>0.10 0.04</size>
      <fontPath>${fontRegular}</fontPath>
      <fontSize>0.030</fontSize>
      <color>${textPrimary}</color>
      <format>%H:%M</format>
      <horizontalAlignment>right</horizontalAlignment>
      <zIndex>10</zIndex>
    </datetime>

    <!-- Selected system icon, pinned to the cross anchor so it lines up
         with the system view's selected carousel logo. Full-colour (no
         tint) to match the carousel icon. -->
    <image name="logo">
      <path>./art/system-icons/${system.theme}.png</path>
      <pos>${crossX} ${crossY}</pos>
      <origin>0.5 0.5</origin>
      <maxSize>0.15 0.21</maxSize>
      <zIndex>5</zIndex>
    </image>

    <!-- System-name caption, pinned under the icon - matches the system
         view's caption so the A-press reads as continuous. Shows the
         system SHORT name via ${system.theme}, forced uppercase (NES,
         SNES, ...); extra="true" is required to render non-standard text
         elements on this build. -->
    <text name="systemName" extra="true">
      <pos>${crossX} ${captionY}</pos>
      <origin>0.5 0</origin>
      <size>0.5 0.055</size>
      <fontPath>${fontLight}</fontPath>
      <fontSize>0.034</fontSize>
      <color>${textSecondary}</color>
      <backgroundColor>00000000</backgroundColor>
      <alignment>center</alignment>
      <forceUppercase>true</forceUppercase>
      <text>${system.theme}</text>
      <zIndex>6</zIndex>
    </text>

    <!-- Game list - the vertical arm of the cross, centered under the
         system icon (box centered on crossX, center-aligned text). -->
    <textlist name="gamelist">
      <pos>0.08 0.50</pos>
      <size>0.32 0.42</size>
      <fontPath>${fontRegular}</fontPath>
      <fontSize>0.032</fontSize>
      <horizontalMargin>0.01</horizontalMargin>
      <alignment>center</alignment>
      <primaryColor>${textSecondary}</primaryColor>
      <secondaryColor>${textSecondary}</secondaryColor>
      <selectorColor>${selectorGlow}</selectorColor>
      <selectedColor>${textPrimary}</selectedColor>
      <lineSpacing>1.4</lineSpacing>
      <zIndex>5</zIndex>
    </textlist>

    <!-- Preview panel (right ~40%): highlighted game's name as header,
         then boxart, then metadata. -->
    <text name="md_name">
      <pos>0.55 0.12</pos>
      <size>0.38 0.06</size>
      <fontPath>${fontBold}</fontPath>
      <fontSize>0.035</fontSize>
      <color>${textPrimary}</color>
      <alignment>center</alignment>
      <zIndex>5</zIndex>
    </text>

    <image name="md_image">
      <origin>0.5 0.5</origin>
      <pos>0.74 0.37</pos>
      <maxSize>0.38 0.38</maxSize>
      <color>FFFFFFFF</color>
      <zIndex>5</zIndex>
    </image>

    <text name="md_lbl_releasedate">
      <pos>0.58 0.62</pos>
      <size>0.18 0.04</size>
      <fontPath>${fontLight}</fontPath>
      <fontSize>0.025</fontSize>
      <color>${textSecondary}</color>
      <text>Released</text>
      <zIndex>5</zIndex>
    </text>
    <datetime name="md_releasedate">
      <pos>0.78 0.62</pos>
      <size>0.18 0.04</size>
      <fontPath>${fontRegular}</fontPath>
      <fontSize>0.025</fontSize>
      <color>${textPrimary}</color>
      <format>%Y</format>
      <zIndex>5</zIndex>
    </datetime>

    <text name="md_lbl_players">
      <pos>0.58 0.67</pos>
      <size>0.18 0.04</size>
      <fontPath>${fontLight}</fontPath>
      <fontSize>0.025</fontSize>
      <color>${textSecondary}</color>
      <text>Players</text>
      <zIndex>5</zIndex>
    </text>
    <text name="md_players">
      <pos>0.78 0.67</pos>
      <size>0.18 0.04</size>
      <fontPath>${fontRegular}</fontPath>
      <fontSize>0.025</fontSize>
      <color>${textPrimary}</color>
      <zIndex>5</zIndex>
    </text>

    <text name="md_lbl_rating">
      <pos>0.58 0.72</pos>
      <size>0.18 0.04</size>
      <fontPath>${fontLight}</fontPath>
      <fontSize>0.025</fontSize>
      <color>${textSecondary}</color>
      <text>Rating</text>
      <zIndex>5</zIndex>
    </text>
    <rating name="md_rating">
      <pos>0.78 0.72</pos>
      <size>0.15 0.04</size>
      <color>${accent}</color>
      <zIndex>5</zIndex>
    </rating>

  </view>
</theme>
