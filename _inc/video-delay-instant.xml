<!--
  es-theme-xmb-psp - "Video Delay: Instant".
  Sets ${videoDelay}=0 so the preview video on the selected gamelist row
  starts immediately, with no intervening still-screenshot phase.
  Selected via UI Settings > Theme Configuration > Video Delay > Instant.
  CC-BY-NC-SA 2.0. See CREDITS.md.
-->
<theme>
  <formatVersion>7</formatVersion>
  <variables>
    <videoDelay>0</videoDelay>
  </variables>
</theme>
