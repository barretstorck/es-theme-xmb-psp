<?xml version="1.0" encoding="UTF-8"?>
<!--
  es-theme-xmb-psp - shared variables, fonts, sounds, helpsystem base.
  CC-BY-NC-SA 2.0. See CREDITS.md.
-->
<theme>
  <formatVersion>7</formatVersion>

  <!-- Default colorset = January Blue. Picked so the wave background is
       dark enough to make white text readable when no colorset is chosen
       in UI Settings. Selecting any colorset in the "PSP Color" subset
       overrides these values. -->
  <variables>
    <waveTint>1E3A8A</waveTint>
    <accent>3B82F6</accent>
    <textPrimary>FFFFFF</textPrimary>
    <textSecondary>B0C4DE</textSecondary>
    <selectorGlow>60A5FA</selectorGlow>
    <helpAccent>93C5FD</helpAccent>

    <fontLight>./fonts/RobotoCondensed-Light.ttf</fontLight>
    <fontRegular>./fonts/RobotoCondensed-Regular.ttf</fontRegular>
    <fontBold>./fonts/RobotoCondensed-Bold.ttf</fontBold>

    <soundNavigate>./sounds/navigate.wav</soundNavigate>
    <soundSelect>./sounds/select.wav</soundSelect>
    <soundBack>./sounds/back.wav</soundBack>

    <!-- XMB cross anchor. crossX/crossY = where the selected system icon is
         centered in the system and both gamelist views. captionY = the top
         of the system-name caption, just under the icon — it tracks crossY
         (v0.6 moved both up together when the cross anchor was squared).
         countY = the top of the optional game-count caption (Game Count:
         Show variant only), stacked under captionY. -->
    <crossX>0.24</crossX>
    <crossY>0.291</crossY>
    <captionY>0.401</captionY>
    <countY>0.456</countY>

    <!-- v0.8: geometry variables that may differ per aspect ratio.
         Defaults are the 4:3 (1024x768) values used through v0.7.
         Per-ratio overrides live in _inc/aspect-{8x7,3x2,16x9,1x1}.xml,
         loaded conditionally by theme.xml. See
         docs/superpowers/specs/2026-05-23-v0.8-multi-aspect-ratio-design.md
         for the tuning principles. -->

    <!-- System view: icon + system carousel sizing -->
    <sysIconMaxW>0.12</sysIconMaxW>
    <sysIconMaxH>0.16</sysIconMaxH>
    <sysCarouselLogoW>0.10</sysCarouselLogoW>
    <sysCarouselLogoH>0.14</sysCarouselLogoH>
    <sysCarouselSizeW>1.78</sysCarouselSizeW>
    <sysCarouselPosX>-0.65</sysCarouselPosX>    <!-- = crossX - sysCarouselSizeW/2 = 0.24 - 0.89 = -0.65 (K=1.62 × logoW × maxLogoCount) -->

    <!-- Selected-icon halo. Center-bright gaussian PNG, white-tinted at
         runtime. The halo.png source is square (256×256), so ES's
         <maxSize> aspect-preserving scale makes haloW the binding
         dimension — rendered halo is haloW × haloW screen units
         regardless of haloH (kept proportional for forward-compat
         with a future portrait PNG).
         haloW=0.40 is ~2.5× the icon's apparent width (sysIconMaxW ×
         logoScale = 0.18 at 4:3). The icon obscures the bright center;
         the outer ~55% of the halo's diameter — the gaussian
         shoulder — reads as a diffuse soft glow. Per-aspect overrides
         go in aspect-*.xml if visual checks ever show issues.
         (Design history through v0.9 → v0.9.1 → v0.9.2 lives in
         commits + docs/superpowers/specs/) -->
    <haloW>0.40</haloW>
    <haloH>0.40</haloH>

    <!-- Gamelist (shared by detailed + gamecarousel): pinned icon + vertical arm -->
    <glIconMaxW>0.15</glIconMaxW>
    <glIconMaxH>0.21</glIconMaxH>
    <gameColX>0.08</gameColX>
    <gameColW>0.32</gameColW>
    <gameColTextY>0.50</gameColTextY>
    <!-- gameColCarY positions the gamecarousel container so the
         CENTERED selected boxart has slot[-1] (the unselected item
         above the selected) just below the caption — not in the
         empty space between caption and selected. v0.9.3 round 4
         restored maxLogoCount=3 (multi-visible XMB-style) with
         dimmed unselected (minLogoOpacity=0.3) and larger selected
         (logoScale=1.5) plus halo for visual dominance.
         Math: slot[-1] top edge = caption_bottom + small_gap. Solving
         for gameColCarY = caption_bottom + gap - logoH×container_h/2
         + (container_h - slot_h) / 2 - slot_h; for 4:3 defaults this
         lands around 0.46. -->
    <gameColCarY>0.46</gameColCarY>
    <gameColH>0.42</gameColH>

    <!-- Gamecarousel container-relative boxart sizing.
         Note: ES's vertical carousel slot height is 1/maxLogoCount of the
         container (CarouselComponent.cpp:394). With maxLogoCount=3 each
         slot is 0.333 container-units; gameCarLogoH must stay <= 0.333
         to avoid logo overlap. 0.28 leaves ~0.053 of vertical gap per
         slot (visible padding between thumbnails). v0.9.3 reduced from
         0.37, which was 11% over slot height and produced visible
         overlap of neighbouring boxart on-device. -->
    <gameCarLogoW>0.35</gameCarLogoW>
    <gameCarLogoH>0.28</gameCarLogoH>
    <gameCarLogoScale>1.5</gameCarLogoScale>

    <!-- Right info panel -->
    <panelX>0.43</panelX>
    <panelW>0.55</panelW>
    <!-- v0.11 PR F: description pushed down from 0.60 to 0.66 to clear
         the relocated video bottom (now at 0.64). Height trimmed 0.32 -> 0.26
         to keep the panel within the 0.92 bottom margin. -->
    <panelDescY>0.66</panelDescY>
    <panelDescH>0.26</panelDescH>
    <mdRatingX>0.615</mdRatingX>
    <mdVideoX>0.705</mdVideoX>
    <!-- v0.11 PR F: video pushed down + compressed to make room for
         the Year/Genre/Players metadata rows above. Previous values
         (y=0.39, h=0.34) placed video.top at y=0.22, colliding with
         the new rows at y=0.22/0.27/0.32. New: center y=0.50, h=0.28
         puts video.top at 0.36 (clears rows) and video.bottom at 0.64
         (overlaps description start at 0.60 by 0.04 — description
         pushed to 0.66 below). -->
    <mdVideoY>0.50</mdVideoY>
    <mdVideoW>0.50</mdVideoW>
    <mdVideoH>0.28</mdVideoH>

    <!-- v0.11 PR F: metadata key-value rows in the right info panel.
         Three rows (Year / Genre / Players) sit between the rating row
         (y=0.17) and the video (y=0.39 = mdVideoY). Each row is 0.04
         tall. Label column anchored to the info panel's left edge
         (panelX=0.43); value column starts at the midpoint so longer
         values (genre names) don't truncate. mdLabelW deliberately
         tight (0.10) to give the value column more room.
         Hidden via <visible>exists()> when their binding is empty;
         <pos> is not bindable so layout doesn't reflow (audit U2). -->
    <mdLabelX>0.43</mdLabelX>
    <mdValueX>0.55</mdValueX>
    <mdLabelW>0.10</mdLabelW>
    <mdValueW>0.43</mdValueW>
    <mdRowH>0.04</mdRowH>
    <mdYearY>0.22</mdYearY>
    <mdGenreY>0.27</mdGenreY>
    <mdPlayersY>0.32</mdPlayersY>
  </variables>

  <view name="system,detailed,gamecarousel,menu">
    <!-- Sounds (replace ES default click sounds) -->
    <sound name="systemscroll">
      <path>${soundNavigate}</path>
    </sound>
    <sound name="scroll">
      <path>${soundNavigate}</path>
    </sound>
    <sound name="select">
      <path>${soundSelect}</path>
    </sound>
    <sound name="back">
      <path>${soundBack}</path>
    </sound>

    <!-- Helpsystem styling shared across all views -->
    <helpsystem name="help">
      <pos>0.02 0.94</pos>
      <textColor>${textPrimary}</textColor>
      <iconColor>${helpAccent}</iconColor>
      <fontPath>${fontRegular}</fontPath>
      <fontSize>0.025</fontSize>
    </helpsystem>
  </view>

  <!-- Hide ES's built-in OSD overlays so they don't double up with our
       theme. controllerActivity is the white-pink square top-left. -->
  <view name="screen">
    <controllerActivity name="controllerActivity">
      <visible>false</visible>
    </controllerActivity>
    <!-- ES's real wall-clock, top-right, enlarged (v0.6); pos.x nudged
         v0.10 pulled the batteryIcon — vertical-alignment and
         percentage-rendering bugs surfaced on-device couldn't be
         resolved in this iteration. Clock right-aligned at x=0.84
         (right edge at 0.98) leaves the status bar clock-only for
         now. art/battery/* assets and the batteryIcon syntax notes
         are preserved in the tree for the restoration attempt. -->
    <text name="clock">
      <visible>true</visible>
      <pos>0.84 0.03</pos>
      <size>0.14 0.06</size>
      <fontPath>${fontRegular}</fontPath>
      <fontSize>0.042</fontSize>
      <color>${textPrimary}</color>
      <alignment>right</alignment>
    </text>
  </view>
</theme>
