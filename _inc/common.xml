<?xml version="1.0" encoding="UTF-8"?>
<!--
  es-theme-xmb-psp - shared variables, fonts, sounds, helpsystem base.
  CC-BY-NC-SA 2.0. See CREDITS.md.
-->
<theme>
  <formatVersion>7</formatVersion>

  <!-- Default colorset = January Blue. Picked so the wave background is
       dark enough to make white text readable when no colorset is chosen
       in UI Settings. Selecting any colorset in the "PSP Color" subset
       overrides these values. -->
  <variables>
    <waveTint>1E3A8A</waveTint>
    <accent>3B82F6</accent>
    <textPrimary>FFFFFF</textPrimary>
    <!-- #42 lifted textSecondary 55% toward white in every colorset and here.
         The alternative was a body-text-only ${textBody}, leaving the
         system-carousel caption where it was; the global lift was chosen from
         rendered pixels, so the caption brightens too (measured 2.64 -> 3.52:1).
         Six colorsets have accents so light that no ink colour reaches 3:1 on
         their wave - see the table in the style guide; that is a palette
         question, not a body-text one. -->
    <textSecondary>DBE4F0</textSecondary>
    <selectorGlow>60A5FA</selectorGlow>
    <helpAccent>93C5FD</helpAccent>

    <fontLight>./fonts/RobotoCondensed-Light.ttf</fontLight>
    <fontRegular>./fonts/RobotoCondensed-Regular.ttf</fontRegular>
    <fontBold>./fonts/RobotoCondensed-Bold.ttf</fontBold>

    <!-- #42: the weight used by every body-text element in all three
         gamelist styles. One variable rather than a fontPath per element so
         the whole family moves together - a metadata row in one weight and
         a description in another reads as a mistake.

         A literal path, NOT ${fontLight}: ThemeData::parseVariable routes any
         value containing "${" through MathExpr::evaluate first
         (ThemeData.cpp:1082) and only falls back to placeholder resolution on
         a domain_error, so a variable defined in terms of another variable is
         evaluated as an expression before it is ever treated as a string. -->
    <fontBody>./fonts/RobotoCondensed-Regular.ttf</fontBody>

    <!-- #42: the two opacity cuts body text used to take on top of its
         colour. metaSecondaryOpacity (the card's year/developer line) is now
         1 - it was a legibility tax for no hierarchy the 0.026 size was not
         already carrying. starTrackOpacity cannot go to 1: the track is the
         EMPTY half of the rating pair and has to stay visibly below the
         filled glyphs, and that is a RELATIVE job - so when #42 lifted the
         body ink, this had to come DOWN, not up. It was first raised to 0.45,
         which brightened the track a second time and measured the pair's
         separation falling from 3.45:1 to 2.61:1 on a render. 0.30 measures
         3.23:1 with the lifted ink, holding roughly the relationship the
         theme shipped with, while the track still reads against the wave
         (1.29:1 vs 1.34:1 before). It cannot go much lower without the empty
         stars disappearing into the background entirely. -->
    <starTrackOpacity>0.30</starTrackOpacity>
    <metaSecondaryOpacity>1</metaSecondaryOpacity>

    <soundNavigate>./sounds/navigate.wav</soundNavigate>
    <soundSelect>./sounds/select.wav</soundSelect>
    <soundBack>./sounds/back.wav</soundBack>

    <!-- XMB cross anchor. crossX/crossY = where the selected system icon is
         centered in the system and both gamelist views. captionY = the top
         of the system-name caption, just under the icon — it tracks crossY
         (v0.6 moved both up together when the cross anchor was squared).
         countY = the top of the optional game-count caption (Game Count:
         Show variant only), stacked under captionY. -->
    <crossX>0.24</crossX>
    <crossY>0.291</crossY>
    <captionY>0.401</captionY>
    <countY>0.456</countY>

    <!-- v0.11 v7 gamelist redesign (PR #32 on-device tweaks) — SUPERSEDED by v0.12.
         The gamelist header sits HIGHER than the system view's cross anchor.
         v7 experimented with lowering the icon (glLogoY 0.14->0.18, maxSize
         0.18->0.13 square) and moving the caption down to stay tight below it
         (glCaptionY ~0.27). v0.12 moved these HIGHER AGAIN to fix caption/icon
         collision — see glLogoY/glCaptionY declarations at the v0.12 redesign
         block below (around lines 122-123).
         See docs/screenshots/v0.11-mockups/proposed-v7-ondevice-tweaks.png for
         v0.11's design intent. These are gamelist-only and do NOT touch
         crossY/captionY (which the system view uses). -->

    <!-- v0.8: geometry variables that may differ per aspect ratio.
         Defaults are the 4:3 (1024x768) values used through v0.7.
         Per-ratio overrides live in _inc/aspect-{8x7,3x2,16x9,1x1}.xml,
         loaded conditionally by theme.xml. See
         docs/superpowers/specs/2026-05-23-v0.8-multi-aspect-ratio-design.md
         for the tuning principles. -->

    <!-- System view: icon + system carousel sizing -->
    <sysIconMaxW>0.12</sysIconMaxW>
    <sysIconMaxH>0.16</sysIconMaxH>
    <sysCarouselLogoW>0.10</sysCarouselLogoW>
    <sysCarouselLogoH>0.14</sysCarouselLogoH>
    <sysCarouselSizeW>1.78</sysCarouselSizeW>
    <sysCarouselPosX>-0.65</sysCarouselPosX>    <!-- = crossX - sysCarouselSizeW/2 = 0.24 - 0.89 = -0.65 (K=1.62 × logoW × maxLogoCount) -->

    <!-- Selected-icon halo. Center-bright gaussian PNG, white-tinted at
         runtime. The halo.png source is square (256×256), so ES's
         <maxSize> aspect-preserving scale makes haloW the binding
         dimension — rendered halo is haloW × haloW screen units
         regardless of haloH (kept proportional for forward-compat
         with a future portrait PNG).
         haloW=0.40 is ~2.5× the icon's apparent width (sysIconMaxW ×
         logoScale = 0.18 at 4:3). The icon obscures the bright center;
         the outer ~55% of the halo's diameter — the gaussian
         shoulder — reads as a diffuse soft glow. Per-aspect overrides
         go in aspect-*.xml if visual checks ever show issues.
         (Design history through v0.9 → v0.9.1 → v0.9.2 lives in
         commits + docs/superpowers/specs/) -->
    <haloW>0.28</haloW>
    <haloH>0.28</haloH>

    <!-- Row-halo size (slot-relative, used by the gamelist itemTemplate
         tplHalo). Sized so the gaussian shoulder reads as a diffuse
         glow around the row icon without clipping vertically against
         the row-slot. -->
    <rowHaloW>0.25</rowHaloW>
    <rowHaloH>1.30</rowHaloH>

    <!-- Gamelist: shared geometry vars. Per-row variables for the v0.11
         card layout are defined below in the v0.11 block; legacy gamecarousel
         /info-panel/glIcon vars were removed in the v0.11 redesign. -->
    <gameColX>0.08</gameColX>
    <gameColW>0.32</gameColW>
    <gameColTextY>0.50</gameColTextY>
    <gameColH>0.42</gameColH>

    <!-- v0.11 PR redesign: PSP-card row format variables.
         See docs/superpowers/specs/2026-05-27-v0.11-gamelist-redesign-design.md.
         IMPORTANT: itemTemplate <pos>/<size>/<maxSize> values are scaled
         by the textlist row-slot's pixel size, not the screen. Slot
         pixel size = (textlist.w * screenW) x (textlist.h / lines *
         screenH). At 4:3 that is roughly 1024 x 128 px, so a value
         like maxSize="0.10 0.13" only yields a 102x17 px icon. Pick
         the y component large enough relative to the slot's short
         pixel-axis (rowIconH=0.80 ~= 100px of a 128px-tall slot). -->
    <!-- ====================================================================
         v6 LAYOUT GEOMETRY (Path B: fixed card extras + textlist peeks).
         All BIG-CARD vars are SCREEN-relative (the card elements are
         extra="true", not inside the textlist). The PEEK vars split into a
         SCREEN-relative width cap (peekIconW) and a SLOT-relative height
         (peekIconH) because the peek icons live in the textlist itemTemplate.
         ==================================================================== -->

    <!-- v0.12: slot centres are forced even by <lines>3</lines>:
         centre_i = glListTop + glListH*(i+0.5)/3 -> 0.335 / 0.585 / 0.835.
         cardY MUST equal the middle centre. Widened from v0.11's 0.245/0.69
         to move the peek rows clear of the enlarged card and the caption. -->
    <glListTop>0.21</glListTop>
    <glListH>0.75</glListH>
    <cardY>0.585</cardY>

    <!-- v0.12: header moved up so the caption stops colliding with the icon. -->
    <glLogoY>0.110</glLogoY>
    <glCaptionY>0.222</glCaptionY>

    <!-- v0.12: screenshot/video block above the title. Fills the region that
         was dead space, and is the media slot for the screenshot->video
         handoff. Centred in the card's text column so square-ish sources
         (10:9 Game Boy) and wide ones (16:9) both read as deliberate. -->
    <cardMediaX>0.6775</cardMediaX>
    <cardMediaY>0.290</cardMediaY>
    <cardMediaW>0.40</cardMediaW>
    <cardMediaH>0.34</cardMediaH>

    <!-- v0.12: metadata line 1 is three FIXED columns. The star track is
         always five glyphs wide and {game:stars} is 0-5, so both must be
         left-aligned at one x; stars cannot flow after a variable-width
         genre. Side effect: the v0.11 "long genre pushes stars to line 2"
         fault becomes structurally impossible.
         Budget at 4:3, cardMetaFontSize 0.033 (#42): track spans
         0.530-0.656, so genre is clipped at 0.135 and players starts at
         0.680. Any per-ratio change to cardMetaFontSize MUST re-check this,
         and so must a change to icon-size-boxart.xml / -compact.xml, which
         re-declare cardMetaFontSize and parse AFTER this file. 1:1 is the
         binding ratio - its ceiling is 0.0275 against 0.025 shipped. -->
    <cardGenreW>0.135</cardGenreW>
    <cardStarX>0.530</cardStarX>
    <cardPlayersX>0.680</cardPlayersX>

    <!-- v0.12: bounded description. v0.11 used size height 0.10, which did
         NOT clip on-device and ran under the help strip. -->
    <cardDescY>0.695</cardDescY>
    <cardDescH>0.175</cardDescH>

    <!-- v0.12: folds the videoAudio subset onto the real media element
         (md_video, since #41). The subset previously targeted that element
         while it was hidden, so it was a no-op. -->
    <videoAudioEnabled>false</videoAudioEnabled>

    <!-- Selected boxart: 240px square at 4:3 = 0.234 (W of 1024) x 0.3125
         (H of 768). maxSize preserves aspect, so for a square boxart the
         binding dimension is whichever yields 240px (both do). Overridden
         smaller by the Compact subset. -->
    <cardBoxartW>0.234</cardBoxartW>
    <cardBoxartH>0.3125</cardBoxartH>

    <!-- Big-card text column begins just right of the boxart (boxart right
         edge = crossX + cardBoxartW/2 = 0.24 + 0.117 = 0.357; + gap). -->
    <cardTextX>0.385</cardTextX>
    <cardTextW>0.585</cardTextW>
    <cardTitleY>0.572</cardTitleY>
    <cardTitleFontSize>0.075</cardTitleFontSize>

    <!-- Horizontal line: from cardTextX to the right margin, bisecting the
         boxart at cardY. 2px tall (line-1px.png stretched). -->
    <cardLineW>0.585</cardLineW>
    <cardLineH>0.004</cardLineH>

    <!-- Metadata row, below the line. v7: cardMetaFontSize is the metadata
         size; the description below it has its own smaller font
         (cardDescFontSize ~18px) and wraps within cardTextW (the v0.12
         metadata split moved the description under cardTextX/cardTextW,
         full-width — it no longer has its own narrower column). -->
    <cardMetaY>0.602</cardMetaY>
    <cardMeta2Y>0.643</cardMeta2Y>
    <cardMetaFontSize>0.033</cardMetaFontSize>
    <!-- Metadata line 2 is subordinate to line 1 and, since #42 dropped its
         opacity cut, size is the ONLY thing that says so. It has to be a
         variable for that reason: as a literal 0.026 it was LARGER than
         line 1 at 1:1, where cardMetaFontSize is 0.025. -->
    <cardMeta2FontSize>0.026</cardMeta2FontSize>
    <cardDescFontSize>0.025</cardDescFontSize>

    <!-- Peek icons (prev/next rows): v7 bumped 65px -> 90px square at 4:3.
         peekIconW = 90/1024 = 0.088 (screen width cap); peekIconH = 90/176.6 =
         0.51 (slot height; slot ~176.6px tall at 4:3 = glListH*768/3 with
         glListH=0.69). Overridden smaller by the Compact subset. -->
    <peekIconW>0.088</peekIconW>
    <peekIconH>0.51</peekIconH>
    <peekTitleFontSize>0.030</peekTitleFontSize>

    <!-- Title Visibility subset controls ONLY the peek title's opacity:
         Strict (PSP-Faithful) = 0 (icon-only peeks); Friendly = 1. -->
    <titleUnselectedOpacity>0</titleUnselectedOpacity>

    <!-- v0.12 style B (List + Details). Geometry from the approved mockup
         b-playstation-x.png. Independent of the card's crossX spine. -->
    <listMediaX>0.765</listMediaX>
    <listMediaY>0.300</listMediaY>
    <listMediaW>0.34</listMediaW>
    <listMediaH>0.30</listMediaH>
    <listStarX>0.575</listStarX>
    <listMetaX>0.700</listMetaX>

    <!-- #42: the list panel's metadata size, previously a literal 0.028 on
         each of the four elements. It has to be a variable for the same
         reason cardMetaFontSize is one: the five-glyph star track is
         height-normalised while listStarX/listMetaX are width-normalised, so
         the track's share of the gap between them grows as the screen gets
         squarer. At 1:1 the ceiling is 0.0294 - 0.030 overruns listMetaX by
         3px, which test-gamelist-styles.sh catches. -->
    <listMetaFontSize>0.030</listMetaFontSize>
    <listDescY>0.600</listDescY>
    <listDescH>0.280</listDescH>

    <!-- Video preview delay, in the units ES's <video><delay> expects (seconds,
         matching the values written by _inc/video-delay-*.xml subsets).
         Default 5 matches the pre-v0.11 default; the four user-facing subsets
         (Instant/2s/5s/10s) override this via the videoDelay variable. -->
    <videoDelay>5</videoDelay>

    <!-- v0.12 style D (Box Art Grid). Geometry from the approved mockup
         d-boxart-grid.png: 4 columns x 2 visible rows, info bar beneath.

         gridTileW/gridTileH are the FALLBACK tile size, used only if the grid
         ever stops declaring <autoLayout>: whenever autoLayout is set,
         ImageGridComponent::calcGridDimension (ImageGridComponent.h:1442-1447)
         recomputes mTileSize from the grid rect and discards <gridtile><size>.
         They are therefore inert today. Do NOT add per-ratio overrides for
         them — four such overrides shipped in v0.12 and did nothing, which is
         what led issue #43 to believe tiles differ by aspect ratio. The live
         geometry lives in _inc/gamelist-grid.xml's <imagegrid>, and because
         every value there is a fraction of the same screen dimension, the
         zoom's overlap threshold is identical at all five ratios. -->
    <gridTileW>0.185</gridTileW>
    <gridTileH>0.255</gridTileH>

    <!-- Info bar bands, as variables so a ratio that ever needs to retune them
         can, and so scripts/tests/test-grid-selection.sh can check that the
         text bands sit inside the panel band. Panel spans gridInfoY to
         gridInfoY + gridInfoH; each text row's <pos>/<size> is built from its
         own Y/H pair, and <size> is what bounds it - ES abbreviates a
         single-line text to mSize.x (TextComponent.cpp:376-379). The values
         are v0.12's, unchanged: promoting them to variables must not move a
         pixel, and the guard checks the bands stay inside the panel and do
         not overlap each other. -->
    <gridInfoY>0.795</gridInfoY>
    <gridInfoH>0.110</gridInfoH>
    <gridTitleY>0.808</gridTitleY>
    <gridTitleH>0.055</gridTitleH>
    <gridMetaY>0.862</gridMetaY>
    <gridMetaH>0.040</gridMetaH>
    <!-- The star pair's column. gridStarW bounds it: {game:stars} emits filled
         glyphs only (FileData.cpp:1924), so the track is a fixed five-glyph
         literal today, but nothing structural stopped it growing. -->
    <gridStarX>0.680</gridStarX>
    <gridStarW>0.165</gridStarW>
  </variables>

  <!-- NOTE: "grid" is deliberately ABSENT from this list. Declaring it here
       makes ThemeData::hasView("grid") true unconditionally, which hijacks any
       user who has pinned ES's own Gamelist View Style to "grid": ES then
       builds an unstyled GridGameListView instead of falling back to the
       theme's defaultView. Style D carries its own copy of these elements in
       _inc/gamelist-grid.xml so the grid view is only registered when that
       style is actually selected. Keep the two copies in sync. -->
  <view name="system,detailed,gamecarousel,menu">
    <!-- Sounds (replace ES default click sounds) -->
    <sound name="systemscroll">
      <path>${soundNavigate}</path>
    </sound>
    <sound name="scroll">
      <path>${soundNavigate}</path>
    </sound>
    <sound name="select">
      <path>${soundSelect}</path>
    </sound>
    <sound name="back">
      <path>${soundBack}</path>
    </sound>

    <!-- Helpsystem styling shared across all views -->
    <helpsystem name="help">
      <pos>0.02 0.94</pos>
      <textColor>${textPrimary}</textColor>
      <iconColor>${helpAccent}</iconColor>
      <fontPath>${fontRegular}</fontPath>
      <fontSize>0.025</fontSize>
      <!-- Button glyphs (audit S4, #8). The four face-button slots come from
           the buttonGlyphs subset (_inc/buttons-{nintendo,psp,xbox}.xml); the
           rest are layout-independent and shared by all three sets.

           Slots are nailed to PHYSICAL positions, not to letters:
           iconA=EAST, iconB=SOUTH, iconX=NORTH, iconY=WEST. The derivation is
           in _inc/buttons-nintendo.xml. Get it wrong and nothing errors - the
           glyphs just land on the wrong buttons.

           A path that does not resolve is equally silent: HelpComponent.cpp's
           updateGrid() only uses the themed icon when
           ResourceManager::fileExists() passes, and otherwise falls back to
           ES's built-in :/help/*.svg. A typo therefore looks exactly like
           broken art. scripts/tests/test-button-glyphs.sh checks every path
           in this block exists on disk.

           There is no iconLR slot - ES's helpsystem property map
           (ThemeData.cpp:493-514) has 12 icon properties and the "lr" prompt
           is not among them, so that one prompt keeps ES's stock glyph. -->
      <iconA>${helpIconA}</iconA>
      <iconB>${helpIconB}</iconB>
      <iconX>${helpIconX}</iconX>
      <iconY>${helpIconY}</iconY>
      <iconUpDown>./art/help/dpad-updown.png</iconUpDown>
      <iconLeftRight>./art/help/dpad-leftright.png</iconLeftRight>
      <iconUpDownLeftRight>./art/help/dpad-all.png</iconUpDownLeftRight>
      <iconL>./art/help/shoulder-l.png</iconL>
      <iconR>./art/help/shoulder-r.png</iconR>
      <iconStart>./art/help/btn-start.png</iconStart>
      <iconSelect>./art/help/btn-select.png</iconSelect>
      <iconF1>./art/help/key-f1.png</iconF1>
    </helpsystem>
  </view>

  <!-- Hide ES's built-in OSD overlays so they don't double up with our
       theme. controllerActivity is the white-pink square top-left. -->
  <view name="screen">
    <controllerActivity name="controllerActivity">
      <visible>false</visible>
    </controllerActivity>
    <!-- ES draws a SECOND battery widget of its own: BatteryIndicatorComponent
         (Window.cpp:157, rendered at :746), a ControllerActivityComponent
         subclass pinned top-right at 0.955/0.0125 that shows wifi + battery
         glyph + "NN%" in ES's own font. It is not the controllerActivity
         above — hiding that one leaves this one drawing. It is why v0.10
         concluded <visible>false</visible> "did not hide the icon on-device":
         the theme was hiding its own batteryIcon while ES kept painting this.
         Unlike batteryIcon (whose update() calls setVisible() every tick and
         so overwrites any themed value), this one honours <visible> — its
         render() early-returns on !isVisible() and nothing sets it back. -->
    <batteryIndicator name="batteryIndicator">
      <visible>false</visible>
    </batteryIndicator>

    <!-- Hiding batteryIndicator also removes ES's wifi glyph, so the theme
         draws its own. Auto-hides when disconnected — NetworkIconComponent
         ::update() does setVisible(ShowNetworkIndicator && connected). -->
    <networkIcon name="networkStatus">
      <pos>0.863 0.0612</pos>
      <origin>1 0.5</origin>
      <maxSize>0.033 0.030</maxSize>
      <color>${textPrimary}</color>
      <path>./art/ui/network.png</path>
    </networkIcon>

    <!-- Battery percentage (audit ST1). MUST be a native <batteryText>: a
         binding-based <text extra="true">{global:batteryLevel}%</text> renders
         EMPTY here, because nothing ever resolves bindings in the screen view.
         Window.cpp:1258 builds the screen extras but no BindingManager::
         updateBindings call exists for them (only SystemView, the gamelist
         containers, Splash and the carousel/grid item templates do that). That
         is the real cause of v0.10's "percentage would not render", and it is
         unfixable from the theme — do not retry the binding.

         batteryText auto-sizes its own width (mAutoCalcExtent.x() = 1,
         BatteryTextComponent.cpp:52), which makes <alignment>right</alignment>
         inert: the element is only ever as wide as its text, so pos.x is the
         LEFT edge and the string grows RIGHTWARD toward the glyph. Placed for
         the widest case, "100%" — see the geometry ladder in
         scripts/tests/test-battery.sh, which recomputes it from the font. -->
    <batteryText name="batteryPercent">
      <pos>0.876 0.0612</pos>
      <origin>0 0.5</origin>
      <size>0.060 0.06</size>
      <fontPath>${fontRegular}</fontPath>
      <fontSize>0.030</fontSize>
      <color>${textPrimary}</color>
    </batteryText>

    <!-- Battery glyph, flush to the same 0.98 right margin the clock used to
         hold. ES picks the state image itself from the charge level
         (BatteryIconComponent.cpp:52-69) and calls setVisible(hasBattery), so
         devices without a battery show nothing here and need no theme setting.

         The element TAG must be <batteryIcon> (ES dispatches component types
         by tag name, ThemeData.cpp:2145) and it MUST carry a name attribute
         (unnamed elements are skipped, ThemeData.cpp:1506-1511). Both were hit
         in v0.9.3.

         pos.y 0.0612 + origin y 0.5 is the clock's MEASURED ink centre at
         1024x768 (glyph rows 36..58 px), not the centre of the clock's 0.06
         box — vertical alignment was the third v0.10 blocker and guessing at
         it is what made it unresolvable. -->
    <batteryIcon name="batteryStatus">
      <pos>0.98 0.0612</pos>
      <origin>1 0.5</origin>
      <maxSize>0.046 0.030</maxSize>
      <color>${textPrimary}</color>
      <empty>./art/battery/battery-empty.png</empty>
      <at25>./art/battery/battery-25.png</at25>
      <at50>./art/battery/battery-50.png</at50>
      <at75>./art/battery/battery-75.png</at75>
      <full>./art/battery/battery-full.png</full>
      <incharge>./art/battery/battery-incharge.png</incharge>
    </batteryIcon>

    <!-- ES's real wall-clock, top-right, enlarged (v0.6). Shifted left from
         x=0.84 to clear the battery cluster: right edge = 0.68 + 0.14 = 0.82,
         leaving 0.043 to the network glyph's left edge. -->
    <text name="clock">
      <visible>true</visible>
      <pos>0.68 0.03</pos>
      <size>0.14 0.06</size>
      <fontPath>${fontRegular}</fontPath>
      <fontSize>0.042</fontSize>
      <color>${textPrimary}</color>
      <alignment>right</alignment>
    </text>
  </view>
</theme>
