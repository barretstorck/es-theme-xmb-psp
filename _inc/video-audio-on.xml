<?xml version="1.0" encoding="UTF-8"?>
<!--
  es-theme-xmb-psp - "Video Audio: On".
  Lets the preview video play audio (subject to ES's global
  "Enable video preview audio" setting under Main Menu > Screensaver
  Settings — both must be on for sound).
  Selected via UI Settings > Theme Configuration > Video Audio > On.
  CC-BY-NC-SA 2.0. See CREDITS.md.
-->
<theme>
  <formatVersion>7</formatVersion>
  <!-- v0.12: sets a variable consumed by the <audio> property of the gamelist
       media slot (md_video, since #41). Before v0.12 this subset overrode the
       preview-video element while it was hidden, and was therefore a no-op. -->
  <variables>
    <videoAudioEnabled>true</videoAudioEnabled>
  </variables>
</theme>
