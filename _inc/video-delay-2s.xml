<?xml version="1.0" encoding="UTF-8"?>
<!--
  es-theme-xmb-psp - "Video Delay: 2 seconds".
  Sets ${videoDelay}=2 so the still screenshot shows for 2 seconds before
  the preview video starts on the selected gamelist row.
  Selected via UI Settings > Theme Configuration > Video Delay > 2 seconds.
  CC-BY-NC-SA 2.0. See CREDITS.md.
-->
<theme>
  <formatVersion>7</formatVersion>
  <variables>
    <videoDelay>2</videoDelay>
  </variables>
</theme>
