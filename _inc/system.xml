<?xml version="1.0" encoding="UTF-8"?>
<!--
  es-theme-xmb-psp - system view (PSP XMB top row + animated wave background).
  CC-BY-NC-SA 2.0. See CREDITS.md.
-->
<theme>
  <formatVersion>7</formatVersion>

  <view name="system">

    <!-- Wave background. Center-anchored, 10% over-scanned so storyboard
         motion stays within the visible frame. Uses the staticBackground*
         name prefix: ES routes these through SystemView::mStaticBackgrounds,
         loaded once at view construction and never reset on cursor change.
         Wave therefore persists continuously across navigation (audit S6). -->
    <image name="staticBackgroundWave">
      <path>./art/wave/wave.png</path>
      <pos>0.5 0.5</pos>
      <size>1.10 1.10</size>
      <origin>0.5 0.5</origin>
      <color>${waveTint}</color>
      <zIndex>0</zIndex>
    </image>

    <!-- Wave layer 1: top crest, slowest scroll (copied from
         _inc/wave-motion.xml; the staticBackground* render path
         requires the elements to be declared directly in the view). -->
    <image name="staticBackgroundLayer1">
      <path>./art/wave/wave-layer-1.png</path>
      <pos>0.0 0.5</pos>
      <size>2.00 1.10</size>
      <origin>0.0 0.5</origin>
      <color>${accent}</color>
      <opacity>0.85</opacity>
      <zIndex>1</zIndex>
      <storyboard>
        <animation property="x" from="0.0" to="-1.0"
                   duration="30000" mode="linear"
                   repeat="forever"/>
      </storyboard>
    </image>

    <!-- Wave layer 2: middle crest, medium scroll -->
    <image name="staticBackgroundLayer2">
      <path>./art/wave/wave-layer-2.png</path>
      <pos>0.0 0.5</pos>
      <size>2.00 1.10</size>
      <origin>0.0 0.5</origin>
      <color>${accent}</color>
      <opacity>0.85</opacity>
      <zIndex>2</zIndex>
      <storyboard>
        <animation property="x" from="0.0" to="-1.0"
                   duration="20000" mode="linear"
                   repeat="forever"/>
      </storyboard>
    </image>

    <!-- Wave layer 3: bottom crest, fastest scroll -->
    <image name="staticBackgroundLayer3">
      <path>./art/wave/wave-layer-3.png</path>
      <pos>0.0 0.5</pos>
      <size>2.00 1.10</size>
      <origin>0.0 0.5</origin>
      <color>${accent}</color>
      <opacity>0.85</opacity>
      <zIndex>3</zIndex>
      <storyboard>
        <animation property="x" from="0.0" to="-1.0"
                   duration="12000" mode="linear"
                   repeat="forever"/>
      </storyboard>
    </image>

    <!-- Selected-icon halo: white gaussian behind the focused carousel item.
         Declared inside mStaticBackgrounds (staticBackground* name prefix)
         so it ticks every frame and paints with the wave layers as a
         group, BEFORE the carousel renders on top.

         Paint order within mStaticBackgrounds is set by zIndex
         (SystemView.cpp:1065 stable_sort by zIndex, ascending — lower
         paints first / underneath). The wave base sits at zIndex 0 and
         the three wave layers occupy 1, 2, 3. zIndex=4 places the halo
         ABOVE all wave layers but still BELOW the carousel (zIndex 5+).

         Reuses art/halo.png + haloW/haloH from v0.10's preserved scaffold. -->
    <image name="staticBackgroundHalo">
      <path>./art/halo.png</path>
      <pos>${crossX} ${crossY}</pos>
      <origin>0.5 0.5</origin>
      <maxSize>${haloW} ${haloH}</maxSize>
      <color>FFFFFF</color>
      <zIndex>4</zIndex>
    </image>

    <!-- Horizontal carousel of system icons (PSP "category row"), raised to the y=0.291 XMB cross bar. -->
    <carousel name="systemcarousel">
      <defaultTransition>fade</defaultTransition>
      <type>horizontal</type>
      <!-- Box top y=0.141, height 0.30 -> bar centerline y=0.291 (= crossY).
           Container shifted + widened so its center (the selection point)
           lands at x=0.24 (= crossX) and the icon row spans the full screen
           width: pos.x = crossX - size.x/2 = 0.24 - 0.80 = -0.56.
           maxLogoCount sets how many icons share that width - fewer icons =
           wider spacing. logoPos is avoided - it made the carousel fail to
           render on this build; the container shift is the working mechanism. -->
      <pos>${sysCarouselPosX} 0.141</pos>
      <size>${sysCarouselSizeW} 0.30</size>
      <color>00000000</color>
      <logoSize>${sysCarouselLogoW} ${sysCarouselLogoH}</logoSize>
      <logoScale>1.5</logoScale>
      <logoRotation>0</logoRotation>
      <logoAlignment>center</logoAlignment>
      <maxLogoCount>11</maxLogoCount>
      <textColor>${textSecondary}</textColor>
      <selectedTextColor>${textPrimary}</selectedTextColor>
      <zIndex>5</zIndex>
    </carousel>

    <!-- systemInfo: the carousel-managed name/count element. Positioned here
         so the gamecount subset can control its visibility/delay.
         The carousel engine populates its text; our <text> override is
         ignored by the carousel slot binding. -->
    <text name="systemInfo">
      <pos>${crossX} ${captionY}</pos>
      <origin>0.5 0</origin>
      <size>0.5 0.055</size>
      <fontPath>${fontLight}</fontPath>
      <fontSize>0.034</fontSize>
      <color>${textSecondary}</color>
      <backgroundColor>00000000</backgroundColor>
      <alignment>center</alignment>
      <zIndex>6</zIndex>
    </text>

    <!-- System-name caption: extra text element showing the selected
         system's SHORT name via ${system.theme}, forced uppercase (e.g.
         NES, SNES, PSX). Pinned to the same crossX/captionY as the carousel
         (so both overlay). The gamecount Hide subset keeps this visible;
         Show subset hides it so the carousel's own count cycling
         (systemInfo) can show through.
         Note: extra="true" is required to render in system view on this
         build; this inherits the documented carousel-scroll quirk (caption
         slides during system-change transition), but content updates
         correctly per selected system. -->
    <text name="systemName" extra="true">
      <pos>${crossX} ${captionY}</pos>
      <origin>0.5 0</origin>
      <size>0.5 0.055</size>
      <fontPath>${fontLight}</fontPath>
      <fontSize>0.034</fontSize>
      <color>${textSecondary}</color>
      <backgroundColor>00000000</backgroundColor>
      <alignment>center</alignment>
      <forceUppercase>true</forceUppercase>
      <zIndex>7</zIndex>
      <text>${system.theme}</text>
    </text>

    <!-- Per-system icon. Knulli's ES uses 'logo' as the element name
         (not 'system-logo') and feeds it into the carousel slots.
         ES substitutes ${system.theme} with the current system shortname. -->
    <image name="logo">
      <path>./art/system-icons/${system.theme}.png</path>
      <maxSize>${sysIconMaxW} ${sysIconMaxH}</maxSize>
      <zIndex>6</zIndex>
    </image>

  </view>
</theme>
