<?xml version="1.0" encoding="UTF-8"?>
<!--
  es-theme-xmb-psp - "Battery: Hide".
  For devices without a battery (e.g., docked / desktop setups) or
  users who've disabled ES's Show Battery Status setting. The
  batteryIcon is force-hidden and the clock shifts right to its
  pre-v0.9 position (x=0.84, right edge at 0.92) so there's no empty
  space in the status bar.
  Selected via UI Settings > Theme Configuration > Battery > Hide.
  CC-BY-NC-SA 2.0. See CREDITS.md.
-->
<theme>
  <formatVersion>7</formatVersion>
  <view name="screen">
    <text name="clock">
      <pos>0.84 0.03</pos>
    </text>
    <batteryIcon name="batteryStatus">
      <visible>false</visible>
      <opacity>0</opacity>
    </batteryIcon>
  </view>
</theme>
