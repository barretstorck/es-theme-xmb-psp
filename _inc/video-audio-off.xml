<?xml version="1.0" encoding="UTF-8"?>
<!--
  es-theme-xmb-psp - "Video Audio: Off" (default).
  Force-mutes the preview video regardless of ES's global setting.
  Selected via UI Settings > Theme Configuration > Video Audio > Off.
  CC-BY-NC-SA 2.0. See CREDITS.md.
-->
<theme>
  <formatVersion>7</formatVersion>
  <!-- v0.12: sets a variable consumed by the <audio> property of cardMedia /
       listMedia. Before v0.12 this subset overrode ES's built-in, now-hidden
       preview-video element and was therefore a no-op. -->
  <variables>
    <videoAudioEnabled>false</videoAudioEnabled>
  </variables>
</theme>
